<canvas id="space-canvas" class="fixed inset-0 w-full h-full pointer-events-none" style="z-index:0"></canvas>

<script>
(() => {
  const canvas = document.getElementById('space-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d', { alpha: false });

  let W = 0, H = 0, DPR = 1;
  const STAR_LAYERS = [];
  const NEBULAE = [];
  let time = 0;
  let last = 0;

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    buildStars();
    buildNebulae();
  }

  function buildStars() {
    STAR_LAYERS.length = 0;
    const layerConfigs = [
      { count: Math.floor(W * H / 3500), speed: 0.02, max: 0.8, alpha: 0.55 },
      { count: Math.floor(W * H / 7000), speed: 0.08, max: 1.3, alpha: 0.8 },
      { count: Math.floor(W * H / 18000), speed: 0.22, max: 1.9, alpha: 1 },
    ];
    for (const cfg of layerConfigs) {
      const arr = [];
      for (let i = 0; i < cfg.count; i++) {
        const r = Math.random();
        let color = [225, 232, 255];
        if (r > 0.92) color = [255, 220, 180];
        else if (r > 0.82) color = [180, 210, 255];
        else if (r > 0.75) color = [255, 235, 210];
        arr.push({
          x: Math.random() * W,
          y: Math.random() * H,
          size: Math.random() * cfg.max + 0.2,
          base: 0.4 + Math.random() * 0.6,
          tw: Math.random() * Math.PI * 2,
          twSpeed: 0.5 + Math.random() * 2,
          color,
        });
      }
      STAR_LAYERS.push({ ...cfg, stars: arr });
    }
  }

  function buildNebulae() {
    NEBULAE.length = 0;
    const palette = [
      [40, 80, 180], [90, 50, 170], [30, 140, 200], [120, 60, 160], [200, 90, 140]
    ];
    for (let i = 0; i < 4; i++) {
      NEBULAE.push({
        x: Math.random() * W,
        y: Math.random() * H,
        r: 200 + Math.random() * 300,
        color: palette[Math.floor(Math.random() * palette.length)],
        alpha: 0.05 + Math.random() * 0.08,
        drift: 0.05 + Math.random() * 0.1,
        driftY: (Math.random() - 0.5) * 0.05,
      });
    }
  }

  function drawNebulae() {
    ctx.globalCompositeOperation = 'screen';
    for (const n of NEBULAE) {
      n.x -= n.drift;
      n.y += n.driftY;
      if (n.x + n.r < 0) { n.x = W + n.r; n.y = Math.random() * H; }
      if (n.y < -n.r) n.y = H + n.r;
      if (n.y - n.r > H) n.y = -n.r;
      const g = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, n.r);
      const [r, gc, b] = n.color;
      g.addColorStop(0, `rgba(${r},${gc},${b},${n.alpha})`);
      g.addColorStop(0.4, `rgba(${r},${gc},${b},${n.alpha * 0.4})`);
      g.addColorStop(1, `rgba(${r},${gc},${b},0)`);
      ctx.fillStyle = g;
      ctx.fillRect(n.x - n.r, n.y - n.r, n.r * 2, n.r * 2);
    }
    ctx.globalCompositeOperation = 'source-over';
  }

  function drawStars() {
    for (const layer of STAR_LAYERS) {
      for (const s of layer.stars) {
        s.x -= layer.speed;
        if (s.x < 0) { s.x = W; s.y = Math.random() * H; }
        const twinkle = 0.75 + Math.sin(time * s.twSpeed + s.tw) * 0.25;
        const alpha = s.base * twinkle * layer.alpha;
        const [r, g, b] = s.color;
        ctx.beginPath();
        ctx.fillStyle = `rgba(${r},${g},${b},${alpha})`;
        ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx.fill();
        if (s.size > 1.4 && alpha > 0.85) {
          ctx.beginPath();
          ctx.fillStyle = `rgba(${r},${g},${b},${alpha * 0.15})`;
          ctx.arc(s.x, s.y, s.size * 3, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }
  }

  function roundRect(c, x, y, w, h, r) {
    c.beginPath();
    c.moveTo(x + r, y);
    c.lineTo(x + w - r, y);
    c.quadraticCurveTo(x + w, y, x + w, y + r);
    c.lineTo(x + w, y + h - r);
    c.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    c.lineTo(x + r, y + h);
    c.quadraticCurveTo(x, y + h, x, y + h - r);
    c.lineTo(x, y + r);
    c.quadraticCurveTo(x, y, x + r, y);
    c.closePath();
  }

  // ---- Ship rendering (Constitution-class style, nose points +X) ----
  function drawShip(x, y, scale, angle, bank, depth) {
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(angle);
    // banking: compress perpendicular to heading for a natural roll feel
    const squash = 1 - Math.min(Math.abs(bank) * 0.12, 0.18);
    ctx.scale(scale, scale * squash);
    ctx.globalAlpha = 0.6 + depth * 0.4;

    const H0 = '#cdd6e2';
    const H1 = '#85909f';
    const H2 = '#46515f';
    const H3 = '#2b3442';
    const LINE = '#1f2836';
    const WIN = '#ffe2a0';
    const BUSS = '#ffb34d';
    const GLOW = '#6ef7ff';

    function ell(cx, cy, rx, ry, fill, rot) {
      ctx.fillStyle = fill;
      ctx.beginPath();
      ctx.ellipse(cx, cy, rx, ry, rot || 0, 0, Math.PI * 2);
      ctx.fill();
    }
    function vgrad(y1, y2, c1, c2) {
      const g = ctx.createLinearGradient(0, y1, 0, y2);
      g.addColorStop(0, c1);
      g.addColorStop(1, c2);
      return g;
    }

    // ---- warp engine trails (behind) ----
    ctx.save();
    ctx.globalCompositeOperation = 'screen';
    ctx.shadowColor = GLOW;
    ctx.shadowBlur = 22;
    ctx.fillStyle = GLOW;
    ctx.beginPath();
    ctx.moveTo(-36, -3);
    ctx.lineTo(-62, -7);
    ctx.lineTo(-62, 9);
    ctx.lineTo(-36, 3);
    ctx.closePath();
    ctx.fill();
    ctx.fillRect(-38, -2.5, 3, 5);
    ctx.restore();

    // ---- NACELLES (behind hull) ----
    function nacelle(oy) {
      const up = oy > 0;
      // pylon
      ctx.fillStyle = H2;
      ctx.beginPath();
      ctx.moveTo(4, up ? 4 : -4);
      ctx.lineTo(6, up ? 18 : -18);
      ctx.lineTo(12, up ? 18 : -18);
      ctx.lineTo(14, up ? 4 : -4);
      ctx.closePath();
      ctx.fill();
      // nacelle body shadow
      ctx.fillStyle = H3;
      roundRect(ctx, -20, oy - 4.5, 48, 9, 4);
      ctx.fill();
      const ng = ctx.createLinearGradient(0, oy - 4, 0, oy + 4);
      ng.addColorStop(0, H0);
      ng.addColorStop(0.5, H1);
      ng.addColorStop(1, H3);
      ctx.fillStyle = ng;
      roundRect(ctx, -19, oy - 3.5, 46, 7, 3);
      ctx.fill();
      // grille
      ctx.fillStyle = 'rgba(20,28,40,0.7)';
      for (let i = 0; i < 6; i++) ctx.fillRect(-14 + i * 6, oy - 1.4, 0.6, 2.8);
      // bussard collector (front)
      ctx.save();
      ctx.shadowColor = BUSS;
      ctx.shadowBlur = 10;
      const b = ctx.createRadialGradient(28, oy, 0, 28, oy, 6);
      b.addColorStop(0, '#ffffff');
      b.addColorStop(0.35, BUSS);
      b.addColorStop(0.75, '#e06a00');
      b.addColorStop(1, '#7a2f00');
      ctx.fillStyle = b;
      ctx.beginPath();
      ctx.arc(28, oy, 4.4, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
      // rear engine glow
      ctx.save();
      ctx.shadowColor = GLOW;
      ctx.shadowBlur = 8;
      ctx.fillStyle = GLOW;
      ctx.fillRect(-21, oy - 2, 2, 4);
      ctx.restore();
    }
    nacelle(23);
    nacelle(-23);

    // ---- SECONDARY HULL ----
    ctx.save();
    ctx.shadowColor = 'rgba(0,0,0,0.45)';
    ctx.shadowBlur = 14;
    ell(4, 0, 30, 9, H3);
    ctx.restore();
    const hg = ctx.createLinearGradient(0, -9, 0, 9);
    hg.addColorStop(0, H0);
    hg.addColorStop(0.35, H1);
    hg.addColorStop(0.75, H2);
    hg.addColorStop(1, H3);
    ctx.fillStyle = hg;
    ctx.beginPath();
    ctx.moveTo(18, -6);
    ctx.lineTo(-32, -6);
    ctx.quadraticCurveTo(-38, -6, -38, 0);
    ctx.quadraticCurveTo(-38, 6, -32, 6);
    ctx.lineTo(18, 6);
    ctx.quadraticCurveTo(22, 6, 22, 0);
    ctx.quadraticCurveTo(22, -6, 18, -6);
    ctx.closePath();
    ctx.fill();
    // hull panel lines
    ctx.strokeStyle = 'rgba(31,40,54,0.6)';
    ctx.lineWidth = 0.6;
    for (let i = 0; i < 4; i++) {
      ctx.beginPath();
      ctx.arc(-8 + i * 8, 0, 9, -0.5, 0.5);
      ctx.stroke();
    }
    // registry markings
    ctx.fillStyle = 'rgba(255,255,255,0.28)';
    ctx.fillRect(-26, -2.5, 12, 1.1);

    // ---- NECK ----
    ctx.fillStyle = vgrad(-4, 4, H0, H2);
    ctx.beginPath();
    ctx.moveTo(18, -5);
    ctx.lineTo(28, -3.5);
    ctx.lineTo(28, 3.5);
    ctx.lineTo(18, 5);
    ctx.closePath();
    ctx.fill();

    // ---- SAUCER SECTION ----
    ctx.save();
    ctx.shadowColor = 'rgba(0,0,0,0.5)';
    ctx.shadowBlur = 16;
    ell(46, 0, 34, 15, H3);
    ctx.restore();
    const sg = ctx.createLinearGradient(0, -15, 0, 15);
    sg.addColorStop(0, H0);
    sg.addColorStop(0.4, H1);
    sg.addColorStop(0.8, H2);
    sg.addColorStop(1, H3);
    ctx.fillStyle = sg;
    ctx.beginPath();
    ctx.ellipse(46, 0, 33, 14, 0, 0, Math.PI * 2);
    ctx.fill();
    // rim highlight
    ctx.strokeStyle = 'rgba(205,214,226,0.4)';
    ctx.lineWidth = 0.7;
    ctx.beginPath();
    ctx.ellipse(46, 0, 33, 14, 0, 0, Math.PI * 2);
    ctx.stroke();
    // inner ridge
    ctx.fillStyle = vgrad(-6, 6, H1, H3);
    ctx.beginPath();
    ctx.ellipse(42, 0, 23, 8.5, 0, 0, Math.PI * 2);
    ctx.fill();
    // bridge dome
    ctx.fillStyle = vgrad(-4, 4, H0, H2);
    ctx.beginPath();
    ctx.ellipse(54, -2.5, 5, 3.2, 0, 0, Math.PI * 2);
    ctx.fill();
    // windows along saucer rear edge
    ctx.fillStyle = WIN;
    for (let i = 0; i < 12; i++) {
      const a = Math.PI + (i / 11) * Math.PI;
      const wx = 46 + Math.cos(a) * 29;
      const wy = Math.sin(a) * 12;
      ctx.fillRect(wx - 0.6, wy - 0.5, 1.2, 1);
    }
    // saucer port/starboard running lights
    ctx.fillStyle = '#ff5a5a';
    ctx.fillRect(46, -13.5, 1.6, 1.4);
    ctx.fillStyle = '#59ff9a';
    ctx.fillRect(46, 12.2, 1.6, 1.4);
    // deflector dish glow (front)
    ctx.save();
    ctx.shadowColor = BUSS;
    ctx.shadowBlur = 10;
    const dg = ctx.createRadialGradient(74, 0, 0, 74, 0, 5);
    dg.addColorStop(0, '#ffffff');
    dg.addColorStop(0.5, BUSS);
    dg.addColorStop(1, 'rgba(224,106,0,0)');
    ctx.fillStyle = dg;
    ctx.beginPath();
    ctx.arc(74, 0, 4.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();

    ctx.restore();
  }

  // ---- Smooth elliptical orbit with banking ----
  function getShipState(t) {
    const cx = W * 0.5;
    const cy = H * 0.42;
    const rx = Math.min(W * 0.32, 440);
    const ry = Math.min(H * 0.24, 190);

    const theta = t * 0.045;
    const x = cx + Math.cos(theta) * rx;
    const y = cy + Math.sin(theta) * ry;

    const depth = (1 - Math.sin(theta)) / 2;
    const vf = Math.min(H / 800, 1.25);
    const scale = (0.55 + depth * 0.8) * vf;

    const dx = -Math.sin(theta) * rx;
    const dy = Math.cos(theta) * ry;
    const angle = Math.atan2(dy, dx);

    const ddx = -Math.cos(theta) * rx;
    const ddy = -Math.sin(theta) * ry;
    const sp2 = dx * dx + dy * dy || 1;
    const angAccel = (ddx * dy - dx * ddy) / sp2;
    const bank = -angAccel * 0.14;

    return { x, y, scale, angle, bank, depth };
  }

  function frame(now) {
    const dt = Math.min((now - last) / 1000, 0.05) || 0.016;
    last = now;
    time += dt;

    const bg = ctx.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0, '#020617');
    bg.addColorStop(0.5, '#0a0f2c');
    bg.addColorStop(1, '#020617');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);

    drawNebulae();
    drawStars();

    const s = getShipState(time);
    drawShip(s.x, s.y, s.scale, s.angle, s.bank, s.depth);

    requestAnimationFrame(frame);
  }

  resize();
  window.addEventListener('resize', resize);
  requestAnimationFrame((n) => { last = n; frame(n); });
})();
</script>
