<canvas id="space-canvas" class="fixed inset-0 w-full h-full pointer-events-none" style="z-index:0"></canvas>

<script>
(() => {
  const canvas = document.getElementById('space-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d', { alpha: false });

  let W = 0, H = 0, DPR = 1;
  const STAR_LAYERS = [];
  const NEBULAE = [];
  let time = 0;

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    buildStars();
    buildNebulae();
  }

  function buildStars() {
    STAR_LAYERS.length = 0;
    const layerConfigs = [
      { count: Math.floor(W * H / 3500), speed: 0.02, max: 0.8, alpha: 0.55 },
      { count: Math.floor(W * H / 7000), speed: 0.08, max: 1.3, alpha: 0.8 },
      { count: Math.floor(W * H / 18000), speed: 0.22, max: 1.9, alpha: 1 },
    ];
    for (const cfg of layerConfigs) {
      const arr = [];
      for (let i = 0; i < cfg.count; i++) {
        const r = Math.random();
        let color = [225, 232, 255];
        if (r > 0.92) color = [255, 220, 180];
        else if (r > 0.82) color = [180, 210, 255];
        else if (r > 0.75) color = [255, 235, 210];
        arr.push({
          x: Math.random() * W,
          y: Math.random() * H,
          size: Math.random() * cfg.max + 0.2,
          base: 0.4 + Math.random() * 0.6,
          tw: Math.random() * Math.PI * 2,
          twSpeed: 0.5 + Math.random() * 2,
          color,
        });
      }
      STAR_LAYERS.push({ ...cfg, stars: arr });
    }
  }

  function buildNebulae() {
    NEBULAE.length = 0;
    const palette = [
      [40, 80, 180], [90, 50, 170], [30, 140, 200], [120, 60, 160], [200, 90, 140]
    ];
    for (let i = 0; i < 4; i++) {
      NEBULAE.push({
        x: Math.random() * W,
        y: Math.random() * H,
        r: 200 + Math.random() * 300,
        color: palette[Math.floor(Math.random() * palette.length)],
        alpha: 0.05 + Math.random() * 0.08,
        drift: 0.05 + Math.random() * 0.1,
        driftY: (Math.random() - 0.5) * 0.05,
      });
    }
  }

  function drawNebulae() {
    ctx.globalCompositeOperation = 'screen';
    for (const n of NEBULAE) {
      n.x -= n.drift;
      n.y += n.driftY;
      if (n.x + n.r < 0) { n.x = W + n.r; n.y = Math.random() * H; }
      if (n.y < -n.r) n.y = H + n.r;
      if (n.y - n.r > H) n.y = -n.r;
      const g = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, n.r);
      const [r, gc, b] = n.color;
      g.addColorStop(0, `rgba(${r},${gc},${b},${n.alpha})`);
      g.addColorStop(0.4, `rgba(${r},${gc},${b},${n.alpha * 0.4})`);
      g.addColorStop(1, `rgba(${r},${gc},${b},0)`);
      ctx.fillStyle = g;
      ctx.fillRect(n.x - n.r, n.y - n.r, n.r * 2, n.r * 2);
    }
    ctx.globalCompositeOperation = 'source-over';
  }

  function drawStars() {
    for (const layer of STAR_LAYERS) {
      for (const s of layer.stars) {
        s.x -= layer.speed;
        if (s.x < 0) { s.x = W; s.y = Math.random() * H; }
        const twinkle = 0.75 + Math.sin(time * s.twSpeed + s.tw) * 0.25;
        const alpha = s.base * twinkle * layer.alpha;
        const [r, g, b] = s.color;
        ctx.beginPath();
        ctx.fillStyle = `rgba(${r},${g},${b},${alpha})`;
        ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx.fill();
        if (s.size > 1.4 && alpha > 0.85) {
          ctx.beginPath();
          ctx.fillStyle = `rgba(${r},${g},${b},${alpha * 0.15})`;
          ctx.arc(s.x, s.y, s.size * 3, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }
  }

  function roundRect(c, x, y, w, h, r) {
    c.beginPath();
    c.moveTo(x + r, y);
    c.lineTo(x + w - r, y);
    c.quadraticCurveTo(x + w, y, x + w, y + r);
    c.lineTo(x + w, y + h - r);
    c.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    c.lineTo(x + r, y + h);
    c.quadraticCurveTo(x, y + h, x, y + h - r);
    c.lineTo(x, y + r);
    c.quadraticCurveTo(x, y, x + r, y);
    c.closePath();
  }

  function drawShip(x, y, scale, angle, depth) {
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(angle);
    ctx.scale(scale, scale);
    ctx.globalAlpha = 0.35 + depth * 0.65;

    const hullColor = '#64748b';
    const hullDark = '#1e293b';
    const hullLight = '#cbd5e1';
    const window = '#fde68a';
    const bussardHot = '#fbbf24';
    const bussardGlow = '#67e8f9';
    const engineGlow = '#22d3ee';

    ctx.strokeStyle = hullDark;
    ctx.lineWidth = 1.5;

    function drawNacelle(ox, oy) {
      ctx.fillStyle = hullDark;
      roundRect(ctx, ox, oy, 62, 9, 3);
      ctx.fill();
      const grad = ctx.createLinearGradient(ox, oy, ox, oy + 9);
      grad.addColorStop(0, hullLight);
      grad.addColorStop(0.3, hullColor);
      grad.addColorStop(1, hullDark);
      ctx.fillStyle = grad;
      roundRect(ctx, ox + 2, oy + 1, 58, 7, 2);
      ctx.fill();

      ctx.save();
      ctx.shadowColor = bussardHot;
      ctx.shadowBlur = 15;
      const bg = ctx.createRadialGradient(ox + 60, oy + 4.5, 0, ox + 60, oy + 4.5, 7);
      bg.addColorStop(0, '#ffffff');
      bg.addColorStop(0.4, bussardHot);
      bg.addColorStop(0.8, bussardGlow);
      bg.addColorStop(1, 'rgba(103,232,249,0)');
      ctx.fillStyle = bg;
      ctx.beginPath();
      ctx.ellipse(ox + 61, oy + 4.5, 5, 4, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      ctx.fillStyle = engineGlow;
      ctx.shadowColor = engineGlow;
      ctx.shadowBlur = 8;
      ctx.fillRect(ox - 3, oy + 2, 3, 5);
      ctx.shadowBlur = 0;

      ctx.fillStyle = 'rgba(34,211,238,0.15)';
      ctx.beginPath();
      ctx.moveTo(ox - 3, oy + 2);
      ctx.lineTo(ox - 25, oy - 2);
      ctx.lineTo(ox - 25, oy + 11);
      ctx.lineTo(ox - 3, oy + 7);
      ctx.closePath();
      ctx.fill();

      ctx.fillStyle = 'rgba(15,23,42,0.6)';
      for (let i = 0; i < 6; i++) {
        ctx.fillRect(ox + 10 + i * 8, oy + 2.5, 0.5, 4);
      }
    }

    ctx.beginPath();
    ctx.moveTo(-18, -5);
    ctx.lineTo(-28, -22);
    ctx.lineTo(-10, -22);
    ctx.lineTo(-5, -5);
    ctx.closePath();
    ctx.fillStyle = hullDark;
    ctx.fill();
    ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(-18, 5);
    ctx.lineTo(-28, 22);
    ctx.lineTo(-10, 22);
    ctx.lineTo(-5, 5);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    drawNacelle(-80, -27);
    drawNacelle(-80, 18);

    ctx.fillStyle = hullDark;
    roundRect(ctx, -30, -7, 85, 14, 3);
    ctx.fill();
    const eg = ctx.createLinearGradient(0, -7, 0, 7);
    eg.addColorStop(0, hullLight);
    eg.addColorStop(0.4, hullColor);
    eg.addColorStop(1, hullDark);
    ctx.fillStyle = eg;
    roundRect(ctx, -28, -5.5, 81, 11, 2);
    ctx.fill();

    ctx.fillStyle = window;
    for (let i = 0; i < 7; i++) {
      ctx.fillRect(-15 + i * 8, -2.5, 1.5, 1);
      ctx.fillRect(-15 + i * 8, 1.5, 1.5, 1);
    }

    ctx.save();
    ctx.shadowColor = engineGlow;
    ctx.shadowBlur = 12;
    ctx.fillStyle = engineGlow;
    ctx.fillRect(55, -3, 3, 6);
    ctx.restore();

    ctx.fillStyle = 'rgba(34,211,238,0.2)';
    ctx.beginPath();
    ctx.moveTo(58, -3);
    ctx.lineTo(85, -8);
    ctx.lineTo(85, 8);
    ctx.lineTo(58, 3);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = hullDark;
    ctx.beginPath();
    ctx.ellipse(-55, 0, 48, 18, 0, 0, Math.PI * 2);
    ctx.fill();
    const sg = ctx.createRadialGradient(-55, -6, 2, -55, 0, 48);
    sg.addColorStop(0, hullLight);
    sg.addColorStop(0.5, hullColor);
    sg.addColorStop(1, hullDark);
    ctx.fillStyle = sg;
    ctx.beginPath();
    ctx.ellipse(-55, 0, 46, 16, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.strokeStyle = 'rgba(203,213,225,0.4)';
    ctx.lineWidth = 0.5;
    ctx.beginPath();
    ctx.ellipse(-55, 0, 46, 16, 0, 0, Math.PI * 2);
    ctx.stroke();
    ctx.beginPath();
    ctx.ellipse(-55, 0, 35, 11, 0, 0, Math.PI * 2);
    ctx.stroke();

    ctx.fillStyle = '#0f172a';
    ctx.beginPath();
    ctx.ellipse(-55, 0, 18, 6, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.save();
    ctx.shadowColor = bussardHot;
    ctx.shadowBlur = 8;
    const dg = ctx.createRadialGradient(-55, 0, 0, -55, 0, 6);
    dg.addColorStop(0, '#ffffff');
    dg.addColorStop(0.5, bussardHot);
    dg.addColorStop(1, '#78350f');
    ctx.fillStyle = dg;
    ctx.beginPath();
    ctx.ellipse(-55, 0, 5, 2, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();

    ctx.fillStyle = window;
    const windowR = 36;
    for (let i = 0; i < 14; i++) {
      const a = (i / 14) * Math.PI * 2;
      const wx = -55 + Math.cos(a) * windowR;
      const wy = Math.sin(a) * (windowR * 0.35);
      ctx.fillRect(wx, wy, 1.2, 0.8);
    }

    ctx.fillStyle = hullDark;
    ctx.beginPath();
    ctx.ellipse(-55, -10, 9, 3, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = window;
    for (let i = 0; i < 5; i++) {
      ctx.fillRect(-59 + i * 2, -10.5, 1, 0.6);
    }

    ctx.fillStyle = '#ef4444';
    ctx.fillRect(52, -4, 1, 1);
    ctx.fillStyle = '#22c55e';
    ctx.fillRect(52, 3, 1, 1);

    ctx.restore();
  }

  function getShipState(t) {
    const cx = W * 0.5;
    const cy = H * 0.5;
    const rx = Math.min(W * 0.55, 700);
    const ry = Math.min(H * 0.28, 220);

    const theta = t * 0.08;
    const wobX = Math.sin(t * 0.15) * 30;
    const wobY = Math.cos(t * 0.12) * 15;
    const x = cx + Math.cos(theta) * rx + wobX;
    const y = cy + Math.sin(theta * 2) * ry * 0.4 + wobY;

    const depth = (Math.sin(theta) + 1) / 2;
    const scale = 0.55 + depth * 0.9;

    const dx = -Math.sin(theta) * rx;
    const dy = Math.cos(theta * 2) * ry * 0.4 * 2;
    const angle = Math.atan2(dy, dx) + Math.PI;

    return { x, y, scale, angle, depth };
  }

  function frame() {
    time += 0.016;

    const bg = ctx.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0, '#020617');
    bg.addColorStop(0.5, '#0a0f2c');
    bg.addColorStop(1, '#020617');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);

    drawNebulae();
    drawStars();

    const s = getShipState(time);
    drawShip(s.x, s.y, s.scale, s.angle, s.depth);

    requestAnimationFrame(frame);
  }

  resize();
  window.addEventListener('resize', resize);
  frame();
})();
</script>
