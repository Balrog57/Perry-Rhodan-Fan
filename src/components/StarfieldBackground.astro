<canvas id="space-canvas" class="fixed inset-0 w-full h-full pointer-events-none" style="z-index:0"></canvas>

<script>
(() => {
  const canvas = document.getElementById('space-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d', { alpha: false });

  let W = 0, H = 0, DPR = 1;
  const STAR_LAYERS = [];
  const NEBULAE = [];
  const ASTEROIDS = [];
  const SUPERNOVAE = [];
  const RIPPLE = [];
  const GRAVWAVES = [];
  let time = 0;
  let last = 0;
  let frameCount = 0;

  // ---- SHIP: PNG with alpha, orientation auto-detected at load ----
const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
  const SHIP_LOCAL_LEN = 210; // nose-to-tail size in local units (relative to cone scale)
  const SHIP_FLIP = false;    // set true if the ship flies nose-first backwards
  const SHIP = { img: null, ready: false, corr: 0, drawW: 0, drawH: 0, offX: 0, offY: 0 };

  function loadShip() {
    const img = new Image();
    img.onload = () => {
      try {
        const r = analyzeShip(img);
        SHIP.img = img;
        SHIP.ready = true;
        SHIP.corr = r.corr;
        SHIP.drawW = SHIP_LOCAL_LEN * (img.naturalWidth / r.length);
        SHIP.drawH = SHIP_LOCAL_LEN * (img.naturalHeight / r.length);
        SHIP.offX = ((r.cx - img.naturalWidth / 2) / img.naturalWidth) * SHIP.drawW;
        SHIP.offY = ((r.cy - img.naturalHeight / 2) / img.naturalHeight) * SHIP.drawH;
      } catch (e) { console.error('ship analyze failed', e); }
    };
    img.onerror = () => { console.error('ship image failed to load'); };
    img.src = `${BASE}/images/spaceship.webp`;
  }

  // Detect ship axis, nose direction and alpha centroid from the image pixels.
  function analyzeShip(img) {
    const c = document.createElement('canvas');
    c.width = img.naturalWidth;
    c.height = img.naturalHeight;
    const g = c.getContext('2d', { willReadFrequently: true });
    g.drawImage(img, 0, 0);
    const d = g.getImageData(0, 0, c.width, c.height).data;
    const iw = c.width, ih = c.height;

    const xs = [], ys = [];
    let n = 0, sx = 0, sy = 0;
    for (let y = 0; y < ih; y += 2) {
      for (let x = 0; x < iw; x += 2) {
        if (d[(y * iw + x) * 4 + 3] > 40) { xs.push(x); ys.push(y); sx += x; sy += y; n++; }
      }
    }
    const cx = sx / n, cy = sy / n;
    let cxx = 0, cyy = 0, cxy = 0;
    for (let i = 0; i < n; i++) {
      const dx = xs[i] - cx, dy = ys[i] - cy;
      cxx += dx * dx; cyy += dy * dy; cxy += dx * dy;
    }
    cxx /= n; cyy /= n; cxy /= n;

    const theta = 0.5 * Math.atan2(2 * cxy, cxx - cyy);
    const u0 = Math.cos(theta), v0 = Math.sin(theta);

    let umin = 1e9, umax = -1e9;
    for (let i = 0; i < n; i++) {
      const dx = xs[i] - cx, dy = ys[i] - cy;
      const u = dx * u0 + dy * v0;
      if (u < umin) umin = u;
      if (u > umax) umax = u;
    }
    const L = umax - umin;
    let vnMin = 1e9, vnMax = -1e9, vpMin = 1e9, vpMax = -1e9;
    for (let i = 0; i < n; i++) {
      const dx = xs[i] - cx, dy = ys[i] - cy;
      const u = dx * u0 + dy * v0;
      const v = -dx * v0 + dy * u0;
      if (u < umin + 0.12 * L) {
        if (v < vnMin) vnMin = v;
        if (v > vnMax) vnMax = v;
      } else if (u > umax - 0.12 * L) {
        if (v < vpMin) vpMin = v;
        if (v > vpMax) vpMax = v;
      }
    }
    // nose = the end with the narrower cross-section (pointed tip)
    const crossNeg = vnMax - vnMin;
    const crossPos = vpMax - vpMin;
    const noseNeg = crossNeg < crossPos;
    let nx, ny;
    if (noseNeg) { nx = -u0; ny = -v0; } else { nx = u0; ny = v0; }
    const corr = -Math.atan2(ny, nx);

    return { corr, length: L, cx, cy };
  }

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    buildStars();
    buildNebulae();
    buildAsteroids();
    buildGravWaves();
  }

  // ---- STARS (denser, colored: 10% red / 10% blue) ----
  function buildStars() {
    STAR_LAYERS.length = 0;
    const layerConfigs = [
      { count: Math.floor(W * H / 1400), speed: 0.05, max: 0.8, alpha: 0.5 },
      { count: Math.floor(W * H / 3000), speed: 0.16, max: 1.3, alpha: 0.75 },
      { count: Math.floor(W * H / 8000), speed: 0.42, max: 1.9, alpha: 1 },
    ];
    for (const cfg of layerConfigs) {
      const arr = [];
      for (let i = 0; i < cfg.count; i++) {
        const rr = Math.random();
        let color;
        if (rr < 0.1) color = [205, 120, 110];
        else if (rr < 0.2) color = [120, 185, 255];
        else if (rr > 0.92) color = [255, 220, 180];
        else if (rr > 0.82) color = [180, 210, 255];
        else color = [225, 232, 255];
        arr.push({
          x: Math.random() * W,
          y: Math.random() * H,
          size: Math.random() * cfg.max + 0.2,
          base: 0.4 + Math.random() * 0.6,
          tw: Math.random() * Math.PI * 2,
          twSpeed: 0.4 + Math.random() * 1.8,
          color,
        });
      }
      STAR_LAYERS.push({ ...cfg, stars: arr });
    }
  }

  function drawStars() {
    for (const layer of STAR_LAYERS) {
      for (const s of layer.stars) {
        s.x -= layer.speed;
        if (s.x < 0) { s.x = W; s.y = Math.random() * H; }
        const twinkle = 0.7 + Math.sin(time * s.twSpeed + s.tw) * 0.3;
        const alpha = s.base * twinkle * layer.alpha;
        const [r, g, b] = s.color;
        ctx.beginPath();
        ctx.fillStyle = `rgba(${r},${g},${b},${alpha})`;
        ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx.fill();
        if (s.size > 1.3 && alpha > 0.8) {
          ctx.beginPath();
          ctx.fillStyle = `rgba(${r},${g},${b},${alpha * 0.12})`;
          ctx.arc(s.x, s.y, s.size * 3, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }
  }

  // ---- NEBULAE (Perry Rhodan palette, slow rotation + breathing opacity) ----
  function buildNebulae() {
    NEBULAE.length = 0;
    const palette = [
      [16, 120, 92],
      [150, 30, 180],
      [20, 90, 210],
      [180, 40, 90],
      [60, 60, 200],
    ];
    for (let i = 0; i < 5; i++) {
      NEBULAE.push({
        x: Math.random() * W,
        y: Math.random() * H,
        r: 220 + Math.random() * 320,
        color: palette[Math.floor(Math.random() * palette.length)],
        alpha: 0.05 + Math.random() * 0.09,
        drift: 0.03 + Math.random() * 0.07,
        driftY: (Math.random() - 0.5) * 0.05,
        rot: Math.random() * Math.PI * 2,
        rotSpeed: (Math.random() - 0.5) * 0.02,
        squash: 0.5 + Math.random() * 0.4,
      });
    }
  }

  function drawNebulae(dt) {
    ctx.save();
    ctx.globalCompositeOperation = 'screen';
    for (const n of NEBULAE) {
      n.x -= n.drift;
      n.y += n.driftY;
      n.rot += n.rotSpeed * dt;
      if (n.x + n.r < 0) { n.x = W + n.r; n.y = Math.random() * H; }
      const pulse = 0.85 + 0.15 * Math.sin(time * 0.1 + n.rot);
      ctx.save();
      ctx.translate(n.x, n.y);
      ctx.rotate(n.rot);
      ctx.scale(1, n.squash);
      const g = ctx.createRadialGradient(0, 0, 0, 0, 0, n.r);
      const [r, gc, b] = n.color;
      const a = n.alpha * pulse;
      g.addColorStop(0, `rgba(${r},${gc},${b},${a})`);
      g.addColorStop(0.4, `rgba(${r},${gc},${b},${a * 0.4})`);
      g.addColorStop(1, `rgba(${r},${gc},${b},0)`);
      ctx.fillStyle = g;
      ctx.fillRect(-n.r, -n.r, n.r * 2, n.r * 2);
      ctx.restore();
    }
    ctx.restore();
  }

  // ---- GRAVITY WAVES (space-time distortions drifting among the stars) ----
  function buildGravWaves() {
    GRAVWAVES.length = 0;
    for (let i = 0; i < 5; i++) {
      GRAVWAVES.push({
        x: Math.random() * W,
        y: Math.random() * H,
        r: 26 + Math.random() * 46,
        phase: Math.random() * Math.PI * 2,
        speed: 0.02 + Math.random() * 0.035,
        color: [120, 190, 255],
        alpha: 0.05 + Math.random() * 0.05,
      });
    }
  }

  function drawGravWaves(dt) {
    ctx.save();
    ctx.globalCompositeOperation = 'screen';
    for (const w of GRAVWAVES) {
      w.x -= 0.07;
      if (w.x < -w.r) { w.x = W + w.r; w.y = Math.random() * H; }
      w.phase += dt * w.speed;
      for (let k = 0; k < 3; k++) {
        const r = w.r * (0.35 + k * 0.35 + Math.sin(w.phase) * 0.06);
        ctx.strokeStyle = `rgba(${w.color},${w.alpha * (1 - k * 0.3)})`;
        ctx.lineWidth = 0.6;
        ctx.beginPath();
        ctx.arc(w.x, w.y, r, 0, Math.PI * 2);
        ctx.stroke();
      }
    }
    ctx.restore();
  }

  // ---- SUPERNOVAE (rare, long-lived background events) ----
  function maybeSpawnSupernova() {
    if (frameCount % 500 !== 0 || SUPERNOVAE.length) return;
    SUPERNOVAE.push({
      x: W * 0.15 + Math.random() * W * 0.7,
      y: H * 0.08 + Math.random() * H * 0.4,
      age: 0,
      total: 20,
      maxR: 40 + Math.random() * 60,
    });
  }

  function drawSupernovae(dt) {
    if (!SUPERNOVAE.length) return;
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    for (let i = SUPERNOVAE.length - 1; i >= 0; i--) {
      const sn = SUPERNOVAE[i];
      sn.age += dt;
      if (sn.age > sn.total) { SUPERNOVAE.splice(i, 1); continue; }
      const t = sn.age / sn.total;
      const bright = Math.sin(Math.min(t * 1.15, 1) * Math.PI);
      const r = sn.maxR * bright;
      const g = ctx.createRadialGradient(sn.x, sn.y, 0, sn.x, sn.y, r);
      g.addColorStop(0, `rgba(255,255,255,${0.95 * bright})`);
      g.addColorStop(0.18, `rgba(255,225,190,${0.5 * bright})`);
      g.addColorStop(0.45, `rgba(255,190,140,${0.18 * bright})`);
      g.addColorStop(1, 'rgba(255,170,120,0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(sn.x, sn.y, r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }

  // ---- ASTEROID FIELD (foreground, drifting just below the ship's closest pass) ----
  function buildAsteroids() {
    ASTEROIDS.length = 0;
    for (let i = 0; i < 14; i++) {
      const r = 9 + Math.random() * 24;
      const n = 7 + (Math.random() * 5 | 0);
      const pts = [];
      for (let k = 0; k < n; k++) {
        const a = (k / n) * Math.PI * 2;
        const rr = r * (0.7 + Math.random() * 0.5);
        pts.push([Math.cos(a) * rr, Math.sin(a) * rr]);
      }
      ASTEROIDS.push({
        x: Math.random() * W,
        y: H * (0.72 + Math.random() * 0.3),
        pts,
        rot: Math.random() * Math.PI * 2,
        rotS: (Math.random() - 0.5) * 0.2,
        sp: 0.05 + Math.random() * 0.14,
      });
    }
  }

  function drawAsteroids(dt) {
    ctx.save();
    for (const a of ASTEROIDS) {
      a.x -= a.sp;
      a.rot += a.rotS * dt;
      if (a.x < -70) { a.x = W + 70; a.y = H * (0.7 + Math.random() * 0.35); }
      ctx.save();
      ctx.translate(a.x, a.y);
      ctx.rotate(a.rot);
      ctx.scale(1, 0.55);
      const g = ctx.createRadialGradient(0, -10, 0, 0, 0, 34);
      g.addColorStop(0, 'rgba(125,132,144,0.55)');
      g.addColorStop(0.55, 'rgba(72,78,90,0.5)');
      g.addColorStop(1, 'rgba(28,32,42,0.45)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.moveTo(a.pts[0][0], a.pts[0][1]);
      for (let k = 1; k < a.pts.length; k++) ctx.lineTo(a.pts[k][0], a.pts[k][1]);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    }
    ctx.restore();
  }

  // ---- SHIP (raster image, nose along +X after correction) ----
  function drawShip(x, y, scale, angle, depth) {
    if (!SHIP.ready) return;
    ctx.save();
    const blur = depth > 0.5 ? (depth - 0.5) * 6 : 0;
    ctx.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : 'none';
    ctx.translate(x + SHIP.offX * scale, y + SHIP.offY * scale);
    ctx.rotate(angle + SHIP.corr + (SHIP_FLIP ? Math.PI : 0));
    ctx.transform(1, curPitchShear, 0, 1, 0, 0);
    ctx.globalAlpha = Math.max(0.55, 1 - depth * 0.45);
    const w = SHIP.drawW * scale;
    const h = SHIP.drawH * scale;
    ctx.drawImage(SHIP.img, -w / 2, -h / 2, w, h);
    ctx.restore();
  }

  // ---- KALUP TRANSITION CONE (magenta -> violet, behind the ship) ----
  function drawKalupCone(s) {
    const pulse = 0.8 + 0.2 * Math.sin(time * 7);
    const len = (120 + 130 * s.speed) * s.scale;
    const wHalf = (22 + 16 * (1 - s.speed)) * s.scale;
    ctx.save();
    ctx.translate(s.x, s.y);
    ctx.rotate(s.angle);
    ctx.globalCompositeOperation = 'screen';
    const g = ctx.createLinearGradient(0, 0, -len, 0);
    g.addColorStop(0, `rgba(200,60,220,${0.9 * pulse})`);
    g.addColorStop(0.3, `rgba(150,60,240,${0.55 * pulse})`);
    g.addColorStop(0.7, `rgba(120,50,255,${0.22 * pulse})`);
    g.addColorStop(1, 'rgba(110,40,255,0)');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.moveTo(-10 * s.scale, -wHalf);
    ctx.quadraticCurveTo(-len * 0.7, -wHalf * 0.4, -len, -wHalf * 0.12);
    ctx.lineTo(-len, wHalf * 0.12);
    ctx.quadraticCurveTo(-len * 0.7, wHalf * 0.4, -10 * s.scale, wHalf);
    ctx.closePath();
    ctx.fill();
    // bright inner stream
    const core = ctx.createLinearGradient(-10 * s.scale, 0, -len * 0.85, 0);
    core.addColorStop(0, `rgba(255,180,255,${0.5 * pulse})`);
    core.addColorStop(1, 'rgba(255,180,255,0)');
    ctx.strokeStyle = core;
    ctx.lineWidth = 3 * s.scale * (0.5 + s.speed * 0.5);
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(-12 * s.scale, 0);
    ctx.lineTo(-len * 0.85, 0);
    ctx.stroke();
    ctx.restore();
  }

  // ---- WAKE RIPPLE RINGS (expanding, fading, drawn above the ship) ----
  let rippleAcc = 0;
  function spawnRipple(s, dt) {
    rippleAcc += dt * 1.2;
    if (rippleAcc < 1) return;
    rippleAcc -= 1;
    const vx = Math.cos(s.angle);
    const vy = Math.sin(s.angle);
    const back = ((120 + 130 * s.speed) + 50) * s.scale;
    RIPPLE.push({
      x: s.x - vx * back,
      y: s.y - vy * back,
      r: 8 * s.scale,
      maxR: (90 + Math.random() * 70) * s.scale,
      grow: (70 + Math.random() * 50) * s.scale,
      life: 1,
      decay: 0.5 + Math.random() * 0.25,
      color: Math.random() < 0.5 ? '255,215,130' : '190,120,255',
    });
  }

  function drawRipples(dt) {
    if (!RIPPLE.length) return;
    ctx.save();
    ctx.globalCompositeOperation = 'screen';
    ctx.lineCap = 'round';
    for (let i = RIPPLE.length - 1; i >= 0; i--) {
      const p = RIPPLE[i];
      p.r += p.grow * dt;
      p.life -= p.decay * dt;
      if (p.life <= 0 || p.r >= p.maxR) { RIPPLE.splice(i, 1); continue; }
      const a = Math.max(p.life, 0);
      ctx.strokeStyle = `rgba(${p.color},${a * 0.3})`;
      ctx.lineWidth = 1.6 * a + 0.3;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.stroke();
      ctx.strokeStyle = `rgba(${p.color},${a * 0.12})`;
      ctx.lineWidth = 2.4 * a;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r * 0.7, 0, Math.PI * 2);
      ctx.stroke();
    }
    ctx.restore();
  }

  // ---- TRAJECTORY : wobbling ellipse, variable speed, pitch up/down ----
  let theta = 0;
  let curPitchShear = 0;
  function getShipState(dt) {
    const cx = W * 0.5;
    const cy = H * 0.42;
    const rx = Math.min(W * 0.4, 560);
    const ry = Math.min(H * 0.27, 210);
    const wob = Math.min(ry * 0.35, 70);

    const depth = (1 - Math.sin(theta)) / 2;
    const base = 0.1;
    const boost = 0.16;
    const dTheta = base + boost * (1 - depth);
    theta += dTheta * dt;

    const x = cx + Math.cos(theta) * rx;
    const y = cy + Math.sin(theta) * ry + Math.sin(theta * 2) * wob;

    const dx = -Math.sin(theta) * rx;
    const dy = Math.cos(theta) * ry + 2 * Math.cos(theta * 2) * wob;
    const ddx = -Math.cos(theta) * rx;
    const ddy = -Math.sin(theta) * ry - 4 * Math.sin(theta * 2) * wob;
    const sp2 = dx * dx + dy * dy || 1;
    const angAccel = (ddx * dy - dx * ddy) / sp2;
    const steer = Math.max(-0.22, Math.min(0.22, angAccel * 0.05));
    const angle = Math.atan2(dy, dx) + steer;

    // pitch: cabre vers le haut au premier plan, pique vers le bas à l'arrière-plan
    const pitch = Math.max(-1, Math.min(1, (0.55 - depth) * 1.7));
    curPitchShear = pitch * 0.13;

    const vf = Math.max(0.55, Math.min(1, H / 900));
    const scale = (3.2 - depth * 2.4) * vf;

    const vx = dx * dTheta;
    const vy = dy * dTheta;
    const speed = Math.max(0.4, Math.min(1, Math.hypot(vx, vy) / 240));

    return { x, y, scale, angle, depth, speed };
  }

  function frame(now) {
    const dt = Math.min((now - last) / 1000, 0.05) || 0.016;
    last = now;
    time += dt;
    frameCount++;

    const bg = ctx.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0, '#020617');
    bg.addColorStop(0.5, '#0a0f2c');
    bg.addColorStop(1, '#020617');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);

    drawNebulae(dt);
    drawStars();
    drawGravWaves(dt);
    drawSupernovae(dt);
    maybeSpawnSupernova();

    const s = getShipState(dt);
    spawnRipple(s, dt);
    drawKalupCone(s);
    drawShip(s.x, s.y, s.scale, s.angle, s.depth);
    drawRipples(dt);
    drawAsteroids(dt);

    requestAnimationFrame(frame);
  }

  resize();
  loadShip();
  window.addEventListener('resize', resize);
  requestAnimationFrame((n) => { last = n; frame(n); });
})();
</script>