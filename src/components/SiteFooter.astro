---
import { getEntry } from 'astro:content';

const m = (await getEntry('textes', 'mentions')).data;
---

<footer class="relative z-10 border-t border-blue-500/10 bg-slate-950/90 text-xs text-blue-200/45">
  <div class="max-w-5xl mx-auto px-4 py-6">
    <p class="text-center leading-relaxed">{m.shortLine}</p>

    <details class="mt-3 text-center group">
      <summary class="cursor-pointer list-none inline-flex items-center gap-1 text-blue-200/50 hover:text-blue-200/70 transition-colors select-none">
        <span>{m.summaryLabel}</span>
        <svg class="w-3 h-3 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>

      <div class="mt-4 space-y-2.5 max-w-3xl mx-auto text-blue-200/40 leading-relaxed text-left">
        <p>{m.line1}</p>
        <p>{m.line2}</p>
        <p>{m.line3}</p>
        <p>{m.line4}</p>
        <p>{m.line5}</p>
        <p class="pt-2 flex flex-wrap justify-center gap-x-4 gap-y-1 not-italic">
          <a href={m.officialDeUrl} target="_blank" rel="noopener noreferrer" class="text-blue-300/50 hover:text-cyan-300/70 transition-colors underline underline-offset-2">
            {m.officialDeLabel}
          </a>
          <a href={m.officialFrUrl} target="_blank" rel="noopener noreferrer" class="text-blue-300/50 hover:text-cyan-300/70 transition-colors underline underline-offset-2">
            {m.officialFrLabel}
          </a>
        </p>
      </div>
    </details>
  </div>
</footer>
