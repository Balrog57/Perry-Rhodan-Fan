---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const tomes = await getCollection('tomes');
const chapitres = await getCollection('chapitres');
const cycles = await getCollection('cycles');

const sortedTomes = tomes.sort((a, b) => a.data.chapterNumber - b.data.chapterNumber);
const sortedChapitres = chapitres.sort((a, b) => a.data.chapterNumber - b.data.chapterNumber);
const sortedCycles = cycles.sort((a, b) => a.data.cycleNumber - b.data.cycleNumber);
const base = import.meta.env.BASE_URL;
const t = (await getEntry('textes', 'tomes')).data;
---

<Layout title="Tomes - Perry Rhodan Fan">
  <div class="min-h-screen bg-slate-900">
    <main class="max-w-7xl mx-auto px-4 py-16 pt-24">
      <h1 class="text-4xl md:text-5xl font-bold text-center mb-4 bg-gradient-to-r from-blue-400 via-cyan-300 to-blue-400 bg-clip-text text-transparent">
        {t.title}
      </h1>
      <p class="text-center text-blue-200 mb-10 text-lg">
        {t.subtitle.replace('{count}', sortedTomes.length)}
      </p>

      <div class="flex flex-col md:flex-row gap-4 mb-10 items-stretch md:items-center">
        <div class="flex-1">
          <input
            id="tome-search"
            type="search"
            placeholder={t.searchPlaceholder}
            class="w-full px-4 py-3 bg-slate-800/60 text-white placeholder-blue-300/40 rounded-lg border border-blue-500/20 focus:border-cyan-400/60 focus:outline-none"
          />
        </div>
        <div class="md:w-64">
          <select
            id="tome-cycle"
            class="w-full px-4 py-3 bg-slate-800/60 text-blue-100 rounded-lg border border-blue-500/20 focus:border-cyan-400/60 focus:outline-none"
          >
            <option value="all">{t.allCycles}</option>
            {sortedCycles.filter(c => c.data.type === 'fr').map((cycle) => (
              <option value={cycle.data.cycleNumber}>
                {String(cycle.data.cycleNumber).padStart(2, '0')} — {cycle.data.title}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div id="tome-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
        {sortedTomes.map((tome) => (
          <a
            href={`/Perry-Rhodan-Fan/chapter/tomes/${tome.id}`}
            data-cycle={tome.data.cycleNumber}
            data-title={(tome.data.title || '').toLowerCase()}
            class="tome-card group block bg-slate-800/50 rounded-lg border border-blue-500/20 hover:border-cyan-400/50 transition-all duration-300 overflow-hidden"
          >
            <div class="aspect-[2/3] bg-slate-700 overflow-hidden">
              <img
                src={`${base}${tome.data.cover}`}
                alt={tome.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-3">
              <div class="text-xs text-blue-400 font-mono">{t.badgeN} {tome.data.chapterNumber}</div>
              <h3 class="text-sm font-bold text-white group-hover:text-cyan-300 transition-colors line-clamp-2">
                {tome.data.title}
              </h3>
              <p class="text-[10px] text-blue-300/50 mt-1">{tome.data.parution}</p>
            </div>
          </a>
        ))}
      </div>

      <div id="tome-empty" class="hidden text-center py-20">
        <p class="text-blue-200/50 text-lg">{t.emptyMessage}</p>
      </div>

      <!-- SECTION ALLEMANDE -->
      <section class="mt-24 pt-16 border-t border-blue-500/20">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 bg-gradient-to-r from-purple-300 via-cyan-200 to-blue-300 bg-clip-text text-transparent">
          {t.deTitle}
        </h2>
        <p class="text-center text-blue-200 mb-10 text-lg">
          {t.deSubtitle.replace('{count}', sortedChapitres.length)}
        </p>

        <div class="flex flex-col md:flex-row gap-4 mb-10 items-stretch md:items-center">
          <div class="flex-1">
            <input
              id="de-search"
              type="search"
              placeholder={t.deSearchPlaceholder}
              class="w-full px-4 py-3 bg-slate-800/60 text-white placeholder-blue-300/40 rounded-lg border border-blue-500/20 focus:border-purple-400/60 focus:outline-none"
            />
          </div>
          <div class="md:w-64">
            <select
              id="de-cycle"
              class="w-full px-4 py-3 bg-slate-800/60 text-blue-100 rounded-lg border border-blue-500/20 focus:border-purple-400/60 focus:outline-none"
            >
              <option value="all">{t.deAllCycles}</option>
              {sortedCycles.filter(c => c.data.type === 'de').map((cycle) => (
                <option value={cycle.data.cycleNumber}>
                  {String(cycle.data.cycleNumber).padStart(2, '0')} — {cycle.data.title}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div id="de-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
          {sortedChapitres.map((tome) => (
            <a
              href={`/Perry-Rhodan-Fan/chapter/chapitres/${tome.id}`}
              data-cycle={tome.data.cycleNumber}
              data-title={((tome.data.titleFr || tome.data.title) || '').toLowerCase()}
              class="de-card group block bg-slate-800/50 rounded-lg border border-blue-500/20 hover:border-purple-400/50 transition-all duration-300 overflow-hidden"
            >
              <div class="aspect-[2/3] bg-slate-700 overflow-hidden relative">
                {tome.data.cover ? (
                  <img
                    src={`${base}${tome.data.cover}`}
                    alt={tome.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-gradient-to-b from-slate-700 to-slate-800">
                    <span class="text-4xl font-bold text-purple-500/40">
                      #{String(tome.data.chapterNumber)}
                    </span>
                  </div>
                )}
                <div class={tome.data.statut === 'traduit' ? 'absolute top-2 right-2 px-2 py-0.5 bg-emerald-500/80 text-white text-[10px] font-semibold rounded' : 'absolute top-2 right-2 px-2 py-0.5 bg-purple-600/80 text-white text-[10px] font-semibold rounded'}>
                  {tome.data.statut === 'traduit' ? 'Traduit' : 'À traduire'}
                </div>
              </div>
              <div class="p-3">
                <div class="text-xs text-purple-400 font-mono">{t.badgeN} {tome.data.chapterNumber}</div>
                <h3 class="text-sm font-bold text-white group-hover:text-purple-300 transition-colors line-clamp-2">
                  {tome.data.title}
                </h3>
                {tome.data.titleFr && (
                  <p class="text-[10px] text-blue-300/50 italic mt-1 line-clamp-2">{tome.data.titleFr}</p>
                )}
                <p class="text-[10px] text-blue-300/50 mt-1">{tome.data.parution}</p>
              </div>
            </a>
          ))}
        </div>

        <div id="de-empty" class="hidden text-center py-20">
          <p class="text-blue-200/50 text-lg">{t.deEmptyMessage}</p>
        </div>
      </section>
    </main>
  </div>

  <script>
    const searchInput = document.getElementById('tome-search');
    const cycleSelect = document.getElementById('tome-cycle');
    const cards = Array.from(document.querySelectorAll('.tome-card'));
    const empty = document.getElementById('tome-empty');

    function applyFilters() {
      const q = (searchInput.value || '').toLowerCase().trim();
      const cycle = cycleSelect.value;
      let visible = 0;
      for (const card of cards) {
        const matchCycle = cycle === 'all' || card.dataset.cycle === cycle;
        const matchSearch = !q || card.dataset.title.includes(q);
        const show = matchCycle && matchSearch;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      }
      empty.classList.toggle('hidden', visible !== 0);
    }

    searchInput?.addEventListener('input', applyFilters);
    cycleSelect?.addEventListener('change', applyFilters);

    const deSearchInput = document.getElementById('de-search');
    const deCycleSelect = document.getElementById('de-cycle');
    const deCards = Array.from(document.querySelectorAll('.de-card'));
    const deEmpty = document.getElementById('de-empty');

    function applyDeFilters() {
      const q = (deSearchInput.value || '').toLowerCase().trim();
      const cycle = deCycleSelect.value;
      let visible = 0;
      for (const card of deCards) {
        const matchCycle = cycle === 'all' || card.dataset.cycle === cycle;
        const matchSearch = !q || card.dataset.title.includes(q);
        const show = matchCycle && matchSearch;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      }
      deEmpty.classList.toggle('hidden', visible !== 0);
    }

    deSearchInput?.addEventListener('input', applyDeFilters);
    deCycleSelect?.addEventListener('change', applyDeFilters);
  </script>
</Layout>