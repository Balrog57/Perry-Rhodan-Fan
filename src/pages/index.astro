---
import Layout from '../layouts/Layout.astro';
import StarfieldBackground from '../components/StarfieldBackground.astro';
import { getEntry } from 'astro:content';

const accueil = await getEntry('accueil', 'accueil');
const a = accueil.data;
---

<Layout title={`${a.title} - La plus grande saga de science-fiction`}>
  <StarfieldBackground />

  <section class="relative z-10 min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-blue-950/20 to-slate-950/60 pointer-events-none"></div>

    <div class="relative z-20 text-center px-4 max-w-5xl mx-auto pt-20">
      <h1 class="text-7xl md:text-9xl font-bold mb-6 tracking-wider">
        <span class="bg-gradient-to-r from-blue-300 via-cyan-200 to-blue-300 bg-clip-text text-transparent animate-[shimmer_4s_ease-in-out_infinite] drop-shadow-[0_0_40px_rgba(103,232,249,0.4)]">{a.title}</span>
      </h1>

      <p class="text-2xl md:text-3xl text-blue-100 mb-4 font-light animate-[fadeInUp_1s_ease-out_0.3s_both]">
        {a.tagline}
      </p>

      <p class="text-lg text-blue-300/80 mb-12 max-w-2xl mx-auto animate-[fadeInUp_1s_ease-out_0.6s_both]">
        {a.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center animate-[fadeInUp_1s_ease-out_0.9s_both]">
        <a
          href="/Perry-Rhodan-Fan/cycles"
          class="px-8 py-4 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-semibold rounded-lg shadow-lg shadow-blue-500/50 transform hover:scale-105 transition-all duration-300"
        >
          {a.ctaPrimary} →
        </a>
        <a
          href="#about"
          class="px-8 py-4 bg-slate-800/60 hover:bg-slate-700/80 text-blue-100 font-semibold rounded-lg border border-blue-500/30 hover:border-cyan-400/50 backdrop-blur-sm transition-all duration-300"
        >
          {a.ctaSecondary}
        </a>
      </div>

      <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-6 text-center animate-[fadeInUp_1s_ease-out_1.2s_both]">
        <div class="p-6 bg-slate-900/50 rounded-lg backdrop-blur-md border border-blue-500/20 hover:border-cyan-400/40 transition-colors">
          <div class="text-5xl font-bold text-cyan-400 mb-2">{a.stat1}</div>
          <div class="text-blue-200">{a.stat1Label}</div>
        </div>
        <div class="p-6 bg-slate-900/50 rounded-lg backdrop-blur-md border border-blue-500/20 hover:border-cyan-400/40 transition-colors">
          <div class="text-5xl font-bold text-cyan-400 mb-2">{a.stat2}</div>
          <div class="text-blue-200">{a.stat2Label}</div>
        </div>
        <div class="p-6 bg-slate-900/50 rounded-lg backdrop-blur-md border border-blue-500/20 hover:border-cyan-400/40 transition-colors">
          <div class="text-5xl font-bold text-cyan-400 mb-2">{a.stat3}</div>
          <div class="text-blue-200">{a.stat3Label}</div>
        </div>
      </div>

      <a href="#about" class="mt-16 inline-block animate-bounce" aria-label="Descendre">
        <svg class="w-8 h-8 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>
  </section>

  <section id="about" class="relative z-10 bg-slate-950/95 backdrop-blur-sm py-24 px-4 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(59,130,246,0.08),transparent_60%)]"></div>
    <div class="relative max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">
          {a.sectionAboutTitle}
        </h2>
        <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-cyan-400 mx-auto"></div>
      </div>

      <div class="prose prose-lg prose-invert max-w-none text-blue-100/90 leading-relaxed space-y-6">
        <p class="text-xl text-center text-blue-200 font-light italic max-w-3xl mx-auto">
          « {a.sectionAboutQuote} »
        </p>

        <p>{a.sectionAboutIntro}</p>
        <p>{a.sectionAboutText}</p>
      </div>

      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 bg-gradient-to-br from-slate-800/60 to-slate-900/60 rounded-xl border border-blue-500/20 hover:border-cyan-400/40 transition-all backdrop-blur-sm">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-lg bg-blue-500/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white">{a.card1Title}</h3>
          </div>
          <p class="text-blue-100/80">{a.card1Text}</p>
        </div>

        <div class="p-8 bg-gradient-to-br from-slate-800/60 to-slate-900/60 rounded-xl border border-blue-500/20 hover:border-cyan-400/40 transition-all backdrop-blur-sm">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-lg bg-blue-500/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white">{a.card2Title}</h3>
          </div>
          <p class="text-blue-100/80">{a.card2Text}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative z-10 bg-gradient-to-b from-slate-950 via-blue-950/40 to-slate-950 py-24 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-cyan-300 to-blue-400 bg-clip-text text-transparent">
          {a.sectionOeuvreTitle}
        </h2>
        <div class="w-24 h-1 bg-gradient-to-r from-cyan-400 to-blue-500 mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        <div class="text-center p-8 rounded-xl bg-slate-900/60 border border-blue-500/20 hover:border-cyan-400/40 transition-all backdrop-blur-sm">
          <svg class="w-12 h-12 mx-auto mb-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
          <h3 class="text-xl font-bold text-white mb-2">{a.oeuvre1Title}</h3>
          <p class="text-blue-100/70 text-sm">{a.oeuvre1Text}</p>
        </div>

        <div class="text-center p-8 rounded-xl bg-slate-900/60 border border-blue-500/20 hover:border-cyan-400/40 transition-all backdrop-blur-sm">
          <svg class="w-12 h-12 mx-auto mb-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
          <h3 class="text-xl font-bold text-white mb-2">{a.oeuvre2Title}</h3>
          <p class="text-blue-100/70 text-sm">{a.oeuvre2Text}</p>
        </div>

        <div class="text-center p-8 rounded-xl bg-slate-900/60 border border-blue-500/20 hover:border-cyan-400/40 transition-all backdrop-blur-sm">
          <svg class="w-12 h-12 mx-auto mb-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <h3 class="text-xl font-bold text-white mb-2">{a.oeuvre3Title}</h3>
          <p class="text-blue-100/70 text-sm">{a.oeuvre3Text}</p>
        </div>
      </div>

      <div class="text-center">
        <p class="text-xl text-blue-200 mb-8 font-light max-w-2xl mx-auto">{a.ctaText}</p>
        <a
          href="/Perry-Rhodan-Fan/cycles"
          class="inline-block px-10 py-5 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white text-lg font-semibold rounded-lg shadow-xl shadow-blue-500/40 transform hover:scale-105 transition-all duration-300"
        >
          {a.ctaLabel} →
        </a>
      </div>
    </div>
  </section>

  <style is:global>
    @keyframes shimmer {
      0%, 100% { background-position: 0% 50%; background-size: 200% 200%; }
      50% { background-position: 100% 50%; background-size: 200% 200%; }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    html { scroll-behavior: smooth; }
  </style>
</Layout>
