---
import Layout from '../layouts/Layout.astro';
import StarfieldBackground from '../components/StarfieldBackground.astro';
import { getEntry, getCollection } from 'astro:content';

const accueil = await getEntry('accueil', 'accueil');
const a = accueil.data;
const ht = (await getEntry('textes', 'accueil')).data;
const base = import.meta.env.BASE_URL;
const path = (p) => base.replace(/\/$/, '') + (p.startsWith('/') ? p : '/' + p);

const tomes = await getCollection('tomes');
const cycles = await getCollection('cycles');
const chapitres = await getCollection('chapitres');

const sortedTomes = tomes.sort((x, y) => x.data.chapterNumber - y.data.chapterNumber);
const sortedCycles = cycles.sort((x, y) => x.data.cycleNumber - y.data.cycleNumber);

// Galerie défilante : couvertures des débuts de chaque cycle FR + jalons
const cycleStarts = [1, 22, 44, 66, 88, 138, 188, 216, 234, 242, 256, 282, 298, 306, 332, 354];
const selectedTomes = cycleStarts
  .map((n) => sortedTomes.find((t) => t.data.chapterNumber === n))
  .filter(Boolean);

// Les héros du Perryversum (fiches du site officiel perry-rhodan.net/fuer-einsteiger)
const heroes = [
  {
    name: 'Perry Rhodan',
    role: 'Le héros',
    img: 'images/characters/perry.jpg',
    desc: 'L\'homme qui a conduit l\'humanité vers les étoiles. Surnommé le « Sofortschalter » pour sa capacité à s\'adapter à toute situation, il est le Terranien par excellence : logique, auto-critique et d\'un humour flegmatique.',
  },
  {
    name: 'Atlan da Gonozal',
    role: 'Le prince de cristal',
    img: 'images/characters/atlan.jpg',
    desc: 'L\'Arkonide immortel, aventurier et héros de quatre séries dérivées. Prétendant au trône de l\'Empire, il survécut 8 000 ans sur Terre, influençant l\'Histoire et devenant le paladin de l\'humanité.',
  },
  {
    name: 'Sichu Dorksteiger',
    role: 'La scientifique',
    img: 'images/characters/sichu.jpg',
    desc: 'L\'Ator à la peau verte et aux motifs dorés, scientifique de génie et redoutable combattante. En dépit de son caractère solitaire, elle est réputée pour sa passion du Garrabo et son esprit d\'équipe forgé à l\'armée.',
  },
  {
    name: 'Reginald Bull',
    role: 'Le « Bully »',
    img: 'images/characters/bull.jpg',
    desc: 'Membre de l\'équipage de la STARDUST, il est l\'ami le plus fidèle de Perry Rhodan. Cet optimiste inébranlable — « l\'éternel second » — tient la maison quand le héros sillonne l\'univers.',
  },
  {
    name: 'Gucky',
    role: 'Le « sauveur de l\'univers »',
    img: 'images/characters/gucky.jpg',
    desc: 'Le Mausbiber, passager clandestin de la STARDUST, télépathe, télékinéticien et téléporteur. Menue en apparence, il a sauvé l\'univers plus d\'une fois — et il ne vous laissera pas l\'oublier.',
  },
  {
    name: 'Icho Tolot',
    role: 'Le doux géant',
    img: 'images/characters/tolot.jpg',
    desc: 'Haluter de 3,50 mètres, quatre bras, deux cerveaux : l\'incarnation de la force pacifique. Depuis près de 3 500 ans, il accompagne les Terraniens qu\'il appelle affectueusement « mes petits ».',
  },
];

// Les principaux peuples du Perryversum (fiches du site officiel)
const peoples = [
  { name: 'Les Terraniens', img: 'images/peoples/terraner.png' },
  { name: 'Les Arkonides', img: 'images/peoples/arkoniden.png' },
  { name: 'Les Haluters', img: 'images/peoples/haluter.png' },
  { name: 'Les Maahks', img: 'images/peoples/maahks.png' },
  { name: 'Les Jülziish', img: 'images/peoples/juelziish.png' },
  { name: 'Les Topsides', img: 'images/peoples/topsider.png' },
  { name: 'Les Ators', img: 'images/peoples/ator.png' },
  { name: 'Les Ilts', img: 'images/peoples/ilts.png' },
  { name: 'Les Ferroni', img: 'images/peoples/ferronen.jpg' },
  { name: 'Les Positroniks', img: 'images/peoples/positronik.jpg' },
  { name: 'Les Superintelligences', img: 'images/peoples/superintelligenz.jpg' },
];

// Fond d'écran officiels (galerie perry-rhudan.net/wallpaper)
const wallpapers = [
  { img: 'images/wallpapers/wp-cantaro.png', label: 'PR 1400 — Les dieux de la nuit' },
  { img: 'images/wallpapers/wp-pr3368.jpg', label: 'PR 3368 — Sous des étoiles étrangères' },
  { img: 'images/wallpapers/wp-neo380.jpg', label: 'NEO 380 — Au-delà du voile' },
  { img: 'images/wallpapers/wp-neo-crew.jpg', label: 'L\'équipage NEO 2025' },
  { img: 'images/wallpapers/wp-pr3349.jpg', label: 'PR 3349 — Bataille pour Luna' },
  { img: 'images/wallpapers/wp-pr3350.jpg', label: 'PR 3350 — La chute de Ragnarök' },
  { img: 'images/wallpapers/wp-pr3300.png', label: 'PR 3300 — Terra doit tomber' },
];

// Frise : année  début/fin par cycle (tomes FR 1-17, chapitres DE 18-46)
function yearFromParution(p) {
  if (!p) return null;
  const m = String(p).match(/(19|20)\d{2}/);
  return m ? parseInt(m[1], 10) : null;
}
const timeline = sortedCycles.map((c) => {
  const items = c.data.type === 'fr'
    ? sortedTomes.filter((t) => t.data.cycleNumber === c.data.cycleNumber)
    : chapitres.filter((ch) => ch.data.cycleNumber === c.data.cycleNumber);
  const years = items.map((i) => yearFromParution(i.data.parution)).filter((y) => y !== null);
  return {
    cycle: c,
    startYear: years.length ? Math.min(...years) : null,
    endYear: years.length ? Math.max(...years) : null,
  };
}).filter((t) => t.startYear !== null && t.endYear !== null);
---

<Layout title={`${a.title} - La plus grande saga de science-fiction`}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BookSeries',
    name: 'Perry Rhodan',
    inLanguage: 'fr',
    publisher: { '@type': 'Organization', name: 'Fan Translation' },
    description: 'Traduction fan en français des tomes de l\'édition française (1966-2020) et des fascicules inédits en France.',
    numberOfBooks: `${tomes.length}`,
    isFamilyFriendly: true,
  })} />
  <StarfieldBackground />

  <!-- HERO : wallpaper officiel + texte -->
  <section class="relative z-10 min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={path('images/wallpapers/wp-pr3300.png')}
        alt=""
        class="w-full h-full object-cover opacity-40"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-blue-950/60 to-slate-950/95"></div>
    </div>

    <div class="relative z-20 text-center px-4 max-w-5xl mx-auto pt-20">
      <h1 class="text-7xl md:text-9xl font-bold mb-6 tracking-wider">
        <span class="bg-gradient-to-r from-blue-300 via-cyan-200 to-blue-300 bg-clip-text text-transparent animate-[shimmer_4s_ease-in-out_infinite] drop-shadow-[0_0_40px_rgba(103,232,249,0.4)]">{a.title}</span>
      </h1>
      <p class="text-2xl md:text-3xl text-blue-100 mb-4 font-light animate-[fadeUp_1s_ease-out_0.3s_both]">{a.tagline}</p>
      <p class="text-lg text-blue-300/80 mb-12 max-w-3xl mx-auto animate-[fadeUp_1s_ease-out_0.6s_both]">{a.subtitle}</p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center animate-[fadeUp_1s_ease-out_0.9s_both]">
        <a href={path('tomes')} class="px-8 py-4 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-semibold rounded-lg shadow-lg shadow-blue-500/50 transform hover:scale-105 transition-all duration-300">Découvrir les tomes →</a>
        <a href={path('suite')} class="px-8 py-4 bg-slate-800/60 hover:bg-slate-700/80 text-blue-100 font-semibold rounded-lg border border-blue-500/30 hover:border-cyan-400/50 backdrop-blur-sm transition-all duration-300">Voir la traduction</a>
      </div>

      <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-4 text-center animate-[fadeUp_1s_ease-out_1.2s_both]">
        <div class="p-6 bg-slate-900/50 rounded-lg backdrop-blur-md border border-blue-500/20 hover:border-cyan-400/40 transition-colors">
          <div class="text-5xl font-bold text-cyan-400 mb-2">{sortedTomes.length}</div>
          <div class="text-blue-200">Tomes parus en France</div>
        </div>
        <div class="p-6 bg-slate-900/50 rounded-lg backdrop-blur-md border border-blue-500/20 hover:border-cyan-400/40 transition-colors">
          <div class="text-5xl font-bold text-cyan-400 mb-2">3390</div>
          <div class="text-blue-200">Fascicules parus en Allemagne</div>
        </div>
        <div class="p-6 bg-slate-900/50 rounded-lg backdrop-blur-md border border-blue-500/20 hover:border-cyan-400/40 transition-colors">
          <div class="text-5xl font-bold text-cyan-400 mb-2">{sortedCycles.length}</div>
          <div class="text-blue-200">Cycles à découvrir</div>
        </div>
      </div>

      <a href="#about" class="mt-16 inline-block animate-bounce" aria-label="Descendre">
        <svg class="w-8 h-8 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- GALERIE : bandeau défilant de couvertures -->
  <section class="relative z-10 py-16 overflow-hidden bg-slate-950/60">
    <div class="text-center mb-8 px-4">
      <h2 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-blue-400 via-cyan-300 to-blue-400 bg-clip-text text-transparent">{ht.galleryTitle}</h2>
      <p class="text-blue-200 mt-2">{ht.galleryText.replace('{count}', sortedTomes.length)}</p>
    </div>
    <div class="marquee">
      <div class="marquee-track">
        {[...selectedTomes, ...selectedTomes].map((tome, i) => (
          <a key={`${tome.id}-${i}`} href={path(`chapter/tomes/${tome.id}`)} class="shrink-0 w-36 md:w-40">
            <img
              src={path(tome.data.cover)}
              alt={tome.data.title}
              class="w-full aspect-[2/3] object-cover rounded-lg border border-blue-500/20 hover:border-cyan-400/60 transition-colors"
              loading="lazy"
            />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- LES HÉROS : personnages avec images -->
  <section class="relative z-10 py-24 px-4 overflow-hidden">
    <div class="absolute inset-0">
      <img src={path('images/wallpapers/wp-pr3368.jpg')} alt="" class="w-full h-full object-cover opacity-10" />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-slate-950/85 to-slate-950"></div>
    </div>
    <div class="relative max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-white to-blue-300 bg-clip-text text-transparent">{ht.heroesTitle}</h2>
        <p class="text-blue-200 max-w-2xl mx-auto">{ht.heroesText}</p>
        <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-cyan-400 mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {heroes.map((h) => (
          <article class="group relative overflow-hidden rounded-2xl border border-blue-500/20 hover:border-cyan-400/60 transition-all duration-300 bg-slate-900/70 backdrop-blur-sm hover:-translate-y-1">
            <div class="relative h-64 overflow-hidden">
              <img
                src={path(h.img)}
                alt={h.name}
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent"></div>
              <span class="absolute top-3 left-3 px-3 py-1 text-xs font-semibold uppercase tracking-wider rounded-full bg-blue-600/80 backdrop-blur-sm text-white">{h.role}</span>
              <h3 class="absolute bottom-3 left-4 right-4 text-2xl font-bold text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">{h.name}</h3>
            </div>
            <p class="p-5 text-sm text-blue-100/80 leading-relaxed">{h.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- LES PEUPLES : galerie d'images circulaires -->
  <section class="relative z-10 py-24 px-4 bg-slate-950/95 overflow-hidden">
    <div class="absolute inset-0">
      <img src={path('images/wallpapers/wp-neo380.jpg')} alt="" class="w-full h-full object-cover opacity-10" />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-slate-950/85 to-slate-950"></div>
    </div>
    <div class="relative max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-cyan-300 to-blue-400 bg-clip-text text-transparent">{ht.peoplesTitle}</h2>
        <p class="text-blue-200 max-w-2xl mx-auto">{ht.peoplesText}</p>
        <div class="w-24 h-1 bg-gradient-to-r from-cyan-400 to-blue-500 mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-6 justify-items-center">
        {peoples.map((p) => (
          <div class="group flex flex-col items-center text-center">
            <div class="relative w-24 h-24 md:w-28 md:h-28 rounded-full overflow-hidden ring-2 ring-blue-500/40 group-hover:ring-cyan-400/70 transition-all group-hover:scale-105 duration-300">
              <img src={path(p.img)} alt={p.name} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <span class="mt-3 text-xs md:text-sm font-medium text-blue-100 group-hover:text-cyan-300 transition-colors">{p.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WALLPAPERS : galerie de fonds d'écran officiels -->
  <section class="relative z-10 py-16 overflow-hidden bg-slate-950/90">
    <div class="text-center mb-8 px-4">
      <h2 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-white to-cyan-300 bg-clip-text text-transparent">{ht.wallpapersTitle}</h2>
      <p class="text-blue-200 mt-2">{ht.wallpapersText}</p>
    </div>
    <div class="marquee">
      <div class="marquee-track">
        {[...wallpapers, ...wallpapers].map((w, i) => (
          <a
            key={`${w.label}-${i}`}
            href={path(w.img)}
            target="_blank"
            rel="noopener"
            class="shrink-0 w-72 md:w-96 group"
            aria-label={`Télécharger le fond d'écran ${w.label}`}
          >
            <img
              src={path(w.img)}
              alt={w.label}
              class="w-full h-44 md:h-56 object-cover rounded-lg border border-blue-500/20 group-hover:border-cyan-400/60 transition-colors"
              loading="lazy"
            />
            <span class="block mt-1 text-xs text-blue-200/80 text-center">{w.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PAR OÙ COMMENCER : 3 cartes -->
  <section class="relative z-10 py-24 px-4 bg-slate-950/95">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">{ht.startTitle}</h2>
        <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-cyan-400 mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <a href={path('tomes')} class="group block p-8 bg-gradient-to-br from-slate-800/60 to-slate-900/60 rounded-xl border border-blue-500/20 hover:border-cyan-400/40 transition-all backdrop-blur-sm">
          <div class="w-12 h-12 rounded-lg bg-blue-500/20 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          </div>
          <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors mb-2">{ht.card1Title}</h3>
          <p class="text-blue-100/70 text-sm">{ht.card1Text}</p>
        </a>

        <a href={path('cycles')} class="group block p-8 bg-gradient-to-br from-slate-800/60 to-slate-900/60 rounded-xl border border-blue-500/20 hover:border-cyan-400/40 transition-all backdrop-blur-sm">
          <div class="w-12 h-12 rounded-lg bg-blue-500/20 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/></svg>
          </div>
          <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors mb-2">{ht.card2Title}</h3>
          <p class="text-blue-100/70 text-sm">{ht.card2Text}</p>
        </a>

        <a href={path('suite')} class="group block p-8 bg-gradient-to-br from-slate-800/60 to-slate-900/60 rounded-xl border border-blue-500/20 hover:border-cyan-400/40 transition-all backdrop-blur-sm">
          <div class="w-12 h-12 rounded-lg bg-blue-500/20 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors mb-2">{ht.card3Title}</h3>
          <p class="text-blue-100/70 text-sm">{ht.card3Text}</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FRISE CHRONOLOGIQUE DES CYCLES -->
  <section class="relative z-10 py-24 px-4 bg-slate-950/60">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-cyan-300 to-blue-400 bg-clip-text text-transparent">{ht.timelineTitle}</h2>
        <p class="text-blue-200">{ht.timelineText}</p>
        <div class="w-24 h-1 bg-gradient-to-r from-cyan-400 to-blue-500 mx-auto mt-4"></div>
      </div>

      <div class="relative overflow-x-auto pb-4">
        <div class="flex gap-2 min-w-max px-4">
          {timeline.map((t) => (
            <a key={t.cycle.data.cycleNumber} href={path(`cycles/${t.cycle.data.cycleNumber}`)} class="group w-36 shrink-0">
              <div class="relative overflow-hidden rounded-lg border border-blue-500/20 hover:border-cyan-400/60 transition-all">
                {t.cycle.data.cover ? (
                  <img
                    src={path(t.cycle.data.cover)}
                    alt={t.cycle.data.title}
                    class="w-full aspect-[2/3] object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full aspect-[2/3] bg-gradient-to-b from-blue-700/60 to-slate-800/60 flex items-center justify-center">
                    <span class="text-3xl font-bold text-blue-500/40">{String(t.cycle.data.cycleNumber).padStart(2, '0')}</span>
                  </div>
                )}
                <div class="absolute top-1 left-1 text-[10px] font-mono bg-slate-950/70 px-1.5 py-0.5 rounded text-blue-300">{t.cycle.data.type === 'fr' ? 'FR' : 'DE'}</div>
                <div class="absolute bottom-1 right-1 text-[10px] font-mono bg-slate-950/70 px-1.5 py-0.5 rounded text-blue-200/90">{t.startYear}-{t.endYear}</div>
              </div>
              <div class="mt-1.5 flex items-center gap-1.5">
                <span class="text-sm font-bold text-white group-hover:text-cyan-300">{String(t.cycle.data.cycleNumber).padStart(2, '0')}</span>
                <span class="text-xs text-blue-200/90 line-clamp-2">{t.cycle.data.title}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="relative z-10 bg-slate-950/95 backdrop-blur-sm py-24 px-4 overflow-hidden">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">{a.sectionAboutTitle}</h2>
        <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-cyan-400 mx-auto"></div>
      </div>
      <div class="prose prose-lg prose-invert max-w-none text-blue-100/90 leading-relaxed space-y-6">
        <p class="text-xl text-center text-blue-200 font-light italic max-w-3xl mx-auto">« {a.sectionAboutQuote} »</p>
        <p>{a.sectionAboutIntro}</p>
        <p>{a.sectionAboutText}</p>
      </div>
      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 bg-gradient-to-br from-slate-800/60 to-slate-900/60 rounded-xl border border-blue-500/20 hover:border-cyan-400/40 transition-all backdrop-blur-sm">
          <h3 class="text-2xl font-bold text-white mb-2">{a.card1Title}</h3>
          <p class="text-blue-100/80">{a.card1Text}</p>
        </div>
        <div class="p-8 bg-gradient-to-br from-slate-800/60 to-slate-900/60 rounded-xl border border-blue-500/20 hover:border-cyan-400/40 transition-all backdrop-blur-sm">
          <h3 class="text-2xl font-bold text-white mb-2">{a.card2Title}</h3>
          <p class="text-blue-100/80">{a.card2Text}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative z-10 bg-gradient-to-b from-slate-950 via-blue-950/40 to-slate-950 py-24 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-cyan-300 to-blue-400 bg-clip-text text-transparent">{a.sectionOeuvreTitle}</h2>
        <div class="w-24 h-1 bg-gradient-to-r from-cyan-400 to-blue-500 mx-auto"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        <div class="text-center p-8 rounded-xl bg-slate-900/60 border border-blue-500/20 hover:border-cyan-400/40 transition-all backdrop-blur-sm">
          <h3 class="text-xl font-bold text-white mb-2">{a.oeuvre1Title}</h3>
          <p class="text-blue-100/70 text-sm">{a.oeuvre1Text}</p>
        </div>
        <div class="text-center p-8 rounded-xl bg-slate-900/60 border border-blue-500/20 hover:border-cyan-400/40 transition-all backdrop-blur-sm">
          <h3 class="text-xl font-bold text-white mb-2">{a.oeuvre2Title}</h3>
          <p class="text-blue-100/70 text-sm">{a.oeuvre2Text}</p>
        </div>
        <div class="text-center p-8 rounded-xl bg-slate-900/60 border border-blue-500/20 hover:border-cyan-400/40 transition-all backdrop-blur-sm">
          <h3 class="text-xl font-bold text-white mb-2">{a.oeuvre3Title}</h3>
          <p class="text-blue-100/70 text-sm">{a.oeuvre3Text}</p>
        </div>
      </div>
      <div class="text-center">
        <p class="text-xl text-blue-200 mb-8 font-light max-w-2xl mx-auto">{a.ctaText}</p>
        <a
          href={path('cycles')}
          class="inline-block px-10 py-5 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white text-lg font-semibold rounded-lg shadow-xl shadow-blue-500/40 transform hover:scale-105 transition-all duration-300"
        >
          {a.ctaLabel} →
        </a>
      </div>
    </div>
  </section>

  <style is:global>
    @keyframes shimmer {
      0%, 100% { background-position: 0% 50%; background-size: 200% 200%; }
      50% { background-position: 100% 50%; background-size: 200% 200%; }
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    html { scroll-behavior: smooth; }
    .marquee { width: 100%; overflow: hidden; }
    .marquee-track { display: flex; gap: 1rem; width: max-content; animation: marquee 40s linear infinite; }
    .marquee:hover .marquee-track { animation-play-state: paused; }
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
  </style>
</Layout>