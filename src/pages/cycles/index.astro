---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const cycles = await getCollection('cycles');
const sortedCycles = cycles.sort((a, b) => a.data.cycleNumber - b.data.cycleNumber);
---

<Layout title="Cycles - Perry Rhodan Fan">
  <div class="min-h-screen bg-slate-900">
    <nav class="bg-slate-800/80 backdrop-blur-md border-b border-blue-500/20 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/Perry-Rhodan-Fan/" class="text-2xl font-bold bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">
          PERRY RHODAN
        </a>
        <span class="text-blue-200">Les Cycles</span>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 py-12">
      <h1 class="text-4xl md:text-5xl font-bold text-center mb-4 bg-gradient-to-r from-blue-400 via-cyan-300 to-blue-400 bg-clip-text text-transparent">
        Les Cycles de Perry Rhodan
      </h1>
      <p class="text-center text-blue-200 mb-12 text-lg">
        Explorez l'univers épique à travers 46 cycles légendaires
      </p>

      <div class="mb-12">
        <h2 class="text-2xl font-bold text-cyan-400 mb-6 border-l-4 border-cyan-400 pl-4">Cycles parus en France (1-379)</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedCycles.filter(c => c.data.type === 'fr').map((cycle) => (
            <a href={`/Perry-Rhodan-Fan/cycles/${cycle.data.cycleNumber}`} class="group block bg-slate-800/50 rounded-lg border border-blue-500/20 hover:border-cyan-400/50 transition-all duration-300 overflow-hidden">
              <div class="p-6">
                <div class="flex items-start justify-between mb-3">
                  <span class="text-3xl font-bold text-blue-500/30 group-hover:text-cyan-400/50 transition-colors">
                    {String(cycle.data.cycleNumber).padStart(2, '0')}
                  </span>
                  <span class="px-3 py-1 bg-blue-600/20 text-blue-300 text-xs rounded-full border border-blue-500/30">
                    Tomes {cycle.data.bookStart}-{cycle.data.bookEnd}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-300 transition-colors">
                  {cycle.data.title}
                </h3>
                <p class="text-blue-200/70 text-sm line-clamp-3">
                  {cycle.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-cyan-400 mb-6 border-l-4 border-cyan-400 pl-4">Cycles inédits - Traduction Fan (DE→FR)</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedCycles.filter(c => c.data.type === 'de').map((cycle) => (
            <a href={`/Perry-Rhodan-Fan/cycles/${cycle.data.cycleNumber}`} class="group block bg-slate-800/50 rounded-lg border border-blue-500/20 hover:border-cyan-400/50 transition-all duration-300 overflow-hidden">
              <div class="p-6">
                <div class="flex items-start justify-between mb-3">
                  <span class="text-3xl font-bold text-blue-500/30 group-hover:text-cyan-400/50 transition-colors">
                    {String(cycle.data.cycleNumber).padStart(2, '0')}
                  </span>
                  <span class="px-3 py-1 bg-purple-600/20 text-purple-300 text-xs rounded-full border border-purple-500/30">
                    Fasc. {cycle.data.bookStart}-{cycle.data.bookEnd}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-300 transition-colors">
                  {cycle.data.title}
                </h3>
                <p class="text-blue-200/70 text-sm line-clamp-3">
                  {cycle.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </main>
  </div>
</Layout>
