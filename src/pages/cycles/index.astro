---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const cycles = await getCollection('cycles');
const sortedCycles = cycles.sort((a, b) => a.data.cycleNumber - b.data.cycleNumber);
const base = import.meta.env.BASE_URL;
const path = (p) => base.replace(/\/$/, '') + (p.startsWith('/') ? p : '/' + p);
const t = (await getEntry('textes', 'cycles')).data;
---

<Layout title="Cycles - Perry Rhodan Fan">
  <div class="min-h-screen bg-slate-900">
    <main class="max-w-7xl mx-auto px-4 py-16 pt-24">
      <h1 class="text-4xl md:text-5xl font-bold text-center mb-4 bg-gradient-to-r from-blue-400 via-cyan-300 to-blue-400 bg-clip-text text-transparent">
        {t.title}
      </h1>
      <p class="text-center text-blue-200 mb-12 text-lg">
        {t.subtitle.replace('{count}', sortedCycles.length)}
      </p>

      <div class="mb-12">
        <h2 class="text-2xl font-bold text-cyan-400 mb-6 border-l-4 border-cyan-400 pl-4">{t.frSection}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedCycles.filter(c => c.data.type === 'fr').map((cycle) => (
            <a href={`/Perry-Rhodan-Fan/cycles/${cycle.data.cycleNumber}`} class="group block bg-slate-800/50 rounded-lg border border-blue-500/20 hover:border-cyan-400/50 transition-all duration-300 overflow-hidden flex">
              {cycle.data.cover && (
                <img
                  src={path(cycle.data.cover)}
                  alt={cycle.data.title}
                  class="w-24 h-36 object-cover shrink-0"
                  loading="lazy"
                />
              )}
              <div class="p-6 flex-1">
                <div class="flex items-start justify-between mb-3">
                  <span class="text-3xl font-bold text-blue-500/30 group-hover:text-cyan-400/50 transition-colors">
                    {String(cycle.data.cycleNumber).padStart(2, '0')}
                  </span>
                  <span class="px-3 py-1 bg-blue-600/20 text-blue-300 text-xs rounded-full border border-blue-500/30">
                    {t.badgeTomes.replace('{start}', cycle.data.bookStart).replace('{end}', cycle.data.bookEnd)}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-300 transition-colors">
                  {cycle.data.title}
                </h3>
                <p class="text-blue-200/70 text-sm line-clamp-3">
                  {cycle.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-cyan-400 mb-6 border-l-4 border-cyan-400 pl-4">{t.deSection}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedCycles.filter(c => c.data.type === 'de').map((cycle) => (
            <a href={`/Perry-Rhodan-Fan/cycles/${cycle.data.cycleNumber}`} class="group block bg-slate-800/50 rounded-lg border border-blue-500/20 hover:border-purple-400/50 transition-all duration-300 overflow-hidden flex">
              {cycle.data.cover && (
                <img
                  src={path(cycle.data.cover)}
                  alt={cycle.data.title}
                  class="w-24 h-36 object-cover shrink-0"
                  loading="lazy"
                />
              )}
              <div class="p-6 flex-1">
                <div class="flex items-start justify-between mb-3">
                  <span class="text-3xl font-bold text-purple-500/30 group-hover:text-purple-400/50 transition-colors">
                    {String(cycle.data.cycleNumber).padStart(2, '0')}
                  </span>
                  <span class="px-3 py-1 bg-purple-600/20 text-purple-300 text-xs rounded-full border border-purple-500/30">
                    {t.badgeFasc.replace('{start}', cycle.data.bookStart).replace('{end}', cycle.data.bookEnd)}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-300 transition-colors">
                  {cycle.data.title}
                </h3>
                <p class="text-blue-200/70 text-sm line-clamp-3">
                  {cycle.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </main>
  </div>
</Layout>