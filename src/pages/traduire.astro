---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const chapitres = (await getCollection('chapitres'))
  .slice()
  .sort((a, b) => a.data.chapterNumber - b.data.chapterNumber);
const t = (await getEntry('textes', 'traduire')).data;
const base = import.meta.env.BASE_URL;
const path = (p) => base.replace(/\/$/, '') + (p.startsWith('/') ? p : '/' + p);
const repo = import.meta.env.PUBLIC_GH_REPO || 'Balrog57/Perry-Rhodan-Fan';
const dispatchToken = import.meta.env.PUBLIC_GH_DISPATCH_TOKEN || '';

const catalog = chapitres.map((item) => ({
  slug: item.id,
  chapterNumber: item.data.chapterNumber,
  title: item.data.title,
  titleFr: item.data.titleFr || '',
  statut: item.data.statut || 'wip',
}));

const config = {
  repo,
  token: dispatchToken,
  pullsUrl: `https://github.com/${repo}/pulls?q=is%3Apr+is%3Aopen+label%3Atraduction`,
};
---

<Layout title={t.pageTitle}>
  <div class="min-h-screen bg-slate-900">
    <main class="max-w-3xl mx-auto px-4 py-16 pt-24">
      <a id="back-link" href={path('suite')} class="text-sm text-blue-300 hover:text-cyan-300 transition-colors">
        ← {t.pageTitle}
      </a>

      <div class="mt-6 mb-8">
        <p id="chapter-kicker" class="text-purple-300 font-mono text-sm mb-2 hidden"></p>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">{t.pageTitle}</h1>
        <p id="chapter-title" class="text-lg text-blue-100/90"></p>
        <p id="chapter-title-fr" class="text-blue-300/70 italic"></p>
      </div>

      <p id="intro" class="text-blue-200/90 mb-8 leading-relaxed">{t.missingSlug}</p>

      <form id="translation-form" class="space-y-6">
        <div>
          <label for="slug" class="block text-sm font-medium text-blue-200 mb-2">{t.selectLabel}</label>
          <select
            id="slug"
            name="slug"
            required
            class="w-full px-4 py-3 bg-slate-800/60 text-blue-100 rounded-lg border border-blue-500/20 focus:border-cyan-400/60 focus:outline-none"
          >
            <option value="">{t.selectPlaceholder}</option>
            {catalog.map((item) => (
              <option value={item.slug}>
                n° {item.chapterNumber} — {item.titleFr || item.title} ({item.statut === 'traduit' ? 'traduit' : 'à traduire'})
              </option>
            ))}
          </select>
        </div>

        <fieldset>
          <legend class="text-sm font-medium text-purple-200 mb-3">{t.modeLabel}</legend>
          <div class="grid sm:grid-cols-2 gap-3">
            <label class="cursor-pointer">
              <input type="radio" name="mode" value="traduire" class="peer sr-only" checked />
              <div class="h-full p-4 rounded-xl border border-blue-500/20 bg-slate-800/50 peer-checked:border-cyan-400/60 peer-checked:bg-cyan-950/30 transition-colors">
                <div class="font-semibold text-white">{t.modeTranslate}</div>
                <p class="text-sm text-blue-200/70 mt-1">{t.modeTranslateHint}</p>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="mode" value="deja-traduit" class="peer sr-only" />
              <div class="h-full p-4 rounded-xl border border-blue-500/20 bg-slate-800/50 peer-checked:border-purple-400/60 peer-checked:bg-purple-950/30 transition-colors">
                <div class="font-semibold text-white">{t.modeReady}</div>
                <p class="text-sm text-blue-200/70 mt-1">{t.modeReadyHint}</p>
              </div>
            </label>
          </div>
        </fieldset>

        <div>
          <label for="contributor" class="block text-sm font-medium text-blue-200 mb-2">{t.contributorLabel}</label>
          <input
            id="contributor"
            name="contributor"
            type="text"
            maxlength="80"
            required
            placeholder={t.contributorPlaceholder}
            class="w-full px-4 py-3 bg-slate-800/60 text-white placeholder-blue-300/40 rounded-lg border border-blue-500/20 focus:border-cyan-400/60 focus:outline-none"
          />
        </div>

        <div>
          <label for="titleFr" class="block text-sm font-medium text-blue-200 mb-2">{t.titleFrLabel}</label>
          <input
            id="titleFr"
            name="titleFr"
            type="text"
            maxlength="200"
            required
            placeholder={t.titleFrPlaceholder}
            class="w-full px-4 py-3 bg-slate-800/60 text-white placeholder-blue-300/40 rounded-lg border border-blue-500/20 focus:border-cyan-400/60 focus:outline-none"
          />
        </div>

        <div>
          <label for="body" class="block text-sm font-medium text-blue-200 mb-2">{t.bodyLabel}</label>
          <textarea
            id="body"
            name="body"
            required
            minlength="200"
            rows="18"
            placeholder={t.bodyPlaceholder}
            class="w-full px-4 py-3 bg-slate-800/60 text-blue-50 placeholder-blue-300/40 rounded-lg border border-blue-500/20 focus:border-cyan-400/60 focus:outline-none font-mono text-sm leading-relaxed"
          ></textarea>
          <label class="mt-3 flex items-center gap-3 text-sm text-blue-200/80 cursor-pointer">
            <span>{t.fileLabel}</span>
            <input id="file" type="file" accept=".md,.txt,.text,text/plain,text/markdown" class="text-sm text-blue-300 file:mr-3 file:px-3 file:py-1.5 file:rounded-md file:border-0 file:bg-purple-600/30 file:text-purple-100" />
          </label>
        </div>

        <input type="text" name="website" id="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <label class="flex items-start gap-3 text-sm text-blue-200/80 cursor-pointer">
          <input id="legal" type="checkbox" required class="mt-1 rounded border-blue-500/40 bg-slate-800" />
          <span>{t.legal}</span>
        </label>

        <button
          id="submit-btn"
          type="submit"
          class="w-full px-6 py-3 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-semibold rounded-lg shadow-lg shadow-purple-500/30 transition-all"
        >
          {t.submit}
        </button>
      </form>

      <p id="status" class="mt-6 text-sm text-blue-200/80 hidden"></p>

      <div id="success" class="hidden mt-8 p-6 rounded-xl border border-emerald-500/30 bg-emerald-950/40">
        <h2 class="text-xl font-bold text-emerald-200 mb-2">{t.successTitle}</h2>
        <p class="text-emerald-100/80 mb-4">{t.successText}</p>
        <a id="pr-link" href="#" class="text-cyan-300 hover:text-cyan-200 font-semibold">{t.successLink} →</a>
      </div>

      <div id="fallback" class="hidden mt-8 p-6 rounded-xl border border-amber-500/30 bg-amber-950/30">
        <h2 class="text-xl font-bold text-amber-200 mb-2">{t.fallbackTitle}</h2>
        <p class="text-amber-100/80 mb-4">{t.fallbackText}</p>
        <a id="github-edit" href="#" target="_blank" rel="noopener noreferrer" class="inline-block px-5 py-2.5 bg-amber-600/80 hover:bg-amber-500 text-white font-semibold rounded-lg">
          {t.fallbackOpen}
        </a>
      </div>

      <div id="error" class="hidden mt-8 p-6 rounded-xl border border-red-500/30 bg-red-950/30">
        <h2 class="text-xl font-bold text-red-200 mb-2">{t.errorTitle}</h2>
        <p id="error-detail" class="text-red-100/80"></p>
      </div>
    </main>
  </div>

  <script define:vars={{ config, catalog, labels: { submitting: t.submitting, submit: t.submit, successLink: t.successLink, introWip: t.introWip, introDone: t.introDone, missingSlug: t.missingSlug }, chapterBase: path('chapter/chapitres') }}>
    const form = document.getElementById('translation-form');
    const slugSelect = document.getElementById('slug');
    const statusEl = document.getElementById('status');
    const successEl = document.getElementById('success');
    const fallbackEl = document.getElementById('fallback');
    const errorEl = document.getElementById('error');
    const errorDetail = document.getElementById('error-detail');
    const prLink = document.getElementById('pr-link');
    const submitBtn = document.getElementById('submit-btn');
    const fileInput = document.getElementById('file');
    const bodyInput = document.getElementById('body');
    const titleFrInput = document.getElementById('titleFr');
    const introEl = document.getElementById('intro');
    const kickerEl = document.getElementById('chapter-kicker');
    const titleEl = document.getElementById('chapter-title');
    const titleFrEl = document.getElementById('chapter-title-fr');
    const backLink = document.getElementById('back-link');
    const githubEdit = document.getElementById('github-edit');
    const modeTranslate = form?.querySelector('input[value="traduire"]');
    const modeReady = form?.querySelector('input[value="deja-traduit"]');
    const CHUNK_SIZE = 25000;
    const bySlug = Object.fromEntries(catalog.map((item) => [item.slug, item]));

    function show(el) { el?.classList.remove('hidden'); }
    function hide(el) { el?.classList.add('hidden'); }
    function setStatus(text) {
      if (!statusEl) return;
      statusEl.textContent = text;
      show(statusEl);
    }

    function currentChapter() {
      return bySlug[slugSelect?.value] || null;
    }

    function applyChapter(slug, persistUrl) {
      const item = bySlug[slug];
      if (slugSelect) slugSelect.value = item ? slug : '';
      if (!item) {
        if (kickerEl) hide(kickerEl);
        if (titleEl) titleEl.textContent = '';
        if (titleFrEl) titleFrEl.textContent = '';
        if (introEl) introEl.textContent = labels.missingSlug;
        if (githubEdit) githubEdit.removeAttribute('href');
        return;
      }
      if (kickerEl) {
        kickerEl.textContent = `Fascicule n° ${item.chapterNumber}`;
        show(kickerEl);
      }
      if (titleEl) titleEl.textContent = item.title;
      if (titleFrEl) titleFrEl.textContent = item.titleFr || '';
      if (introEl) introEl.textContent = item.statut === 'traduit' ? labels.introDone : labels.introWip;
      if (titleFrInput && !titleFrInput.value) titleFrInput.value = item.titleFr || '';
      if (backLink) {
        backLink.href = `${chapterBase}/${item.slug}`;
        backLink.textContent = `← ${item.title}`;
      }
      if (githubEdit) {
        githubEdit.href = `https://github.com/${config.repo}/edit/main/src/content/chapitres/${item.slug}.md`;
      }
      if (item.statut === 'traduit') {
        if (modeReady) modeReady.checked = true;
      } else if (modeTranslate) {
        modeTranslate.checked = true;
      }
      if (persistUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set('slug', item.slug);
        history.replaceState({}, '', url);
      }
    }

    const initialSlug = new URLSearchParams(window.location.search).get('slug') || '';
    if (initialSlug) applyChapter(initialSlug, false);

    slugSelect?.addEventListener('change', () => {
      if (titleFrInput) titleFrInput.value = bySlug[slugSelect.value]?.titleFr || '';
      applyChapter(slugSelect.value, true);
    });

    function splitChunks(text) {
      const chunks = [];
      for (let i = 0; i < text.length; i += CHUNK_SIZE) chunks.push(text.slice(i, i + CHUNK_SIZE));
      return chunks.length ? chunks : [''];
    }

    function extractImported(text) {
      const match = text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n([\s\S]*)$/);
      if (!match) return { body: text, titleFr: '' };
      const titleMatch = match[1].match(/^titleFr:\s*(.*)$/m);
      const titleFr = titleMatch ? titleMatch[1].trim().replace(/^["']|["']$/g, '') : '';
      return { body: match[2].trim(), titleFr };
    }

    fileInput?.addEventListener('change', async () => {
      const file = fileInput.files && fileInput.files[0];
      if (!file) return;
      const imported = extractImported(await file.text());
      if (bodyInput) bodyInput.value = imported.body;
      if (imported.titleFr && titleFrInput && !titleFrInput.value) titleFrInput.value = imported.titleFr;
    });

    async function dispatchChunk(payload) {
      const response = await fetch(`https://api.github.com/repos/${config.repo}/dispatches`, {
        method: 'POST',
        headers: {
          Accept: 'application/vnd.github+json',
          Authorization: `Bearer ${config.token}`,
          'X-GitHub-Api-Version': '2022-11-28',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          event_type: 'translation-proposal',
          client_payload: payload,
        }),
      });
      if (!response.ok) {
        const detail = await response.text();
        throw new Error(`GitHub ${response.status}: ${detail.slice(0, 180)}`);
      }
    }

    async function waitForPr(headRef) {
      const owner = config.repo.split('/')[0];
      const url = `https://api.github.com/repos/${config.repo}/pulls?state=open&head=${owner}:${headRef}`;
      for (let i = 0; i < 36; i += 1) {
        await new Promise((r) => setTimeout(r, 5000));
        try {
          const res = await fetch(url, { headers: { Accept: 'application/vnd.github+json' } });
          if (!res.ok) continue;
          const prs = await res.json();
          if (Array.isArray(prs) && prs[0]) return prs[0];
        } catch { /* polling */ }
      }
      return null;
    }

    function downloadMarkdown(filename, content) {
      const blob = new Blob([content], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.click();
      URL.revokeObjectURL(url);
    }

    async function copyText(text) {
      try { await navigator.clipboard.writeText(text); } catch { /* ignore */ }
    }

    function buildFallbackFile(item, { titleFr, contributor, body }) {
      return [
        '---',
        `title: ${JSON.stringify(item.title)}`,
        `titleFr: ${JSON.stringify(titleFr)}`,
        'statut: traduit',
        `traducteur: ${JSON.stringify(contributor)}`,
        '---',
        '',
        body.trim(),
        '',
      ].join('\n');
    }

    function yamlQuote(value) {
      return JSON.stringify(String(value).replace(/\r\n/g, '\n').trim());
    }

    function upsertFrontmatter(yaml, key, value) {
      const re = new RegExp(`^${key}:.*$`, 'm');
      const line = `${key}: ${value}`;
      return re.test(yaml) ? yaml.replace(re, line) : `${yaml.trimEnd()}\n${line}`;
    }

    function applyProposal(existing, { titleFr, contributor, body }) {
      const match = existing.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
      if (!match) return '';
      let frontmatter = match[1];
      frontmatter = upsertFrontmatter(frontmatter, 'statut', 'traduit');
      if (titleFr) frontmatter = upsertFrontmatter(frontmatter, 'titleFr', yamlQuote(titleFr));
      if (contributor) frontmatter = upsertFrontmatter(frontmatter, 'traducteur', yamlQuote(contributor));
      return `---\n${frontmatter.trimEnd()}\n---\n\n${body.trim()}\n`;
    }

    async function useFallback(item, fields) {
      let file;
      try {
        const raw = await fetch(`https://raw.githubusercontent.com/${config.repo}/main/src/content/chapitres/${item.slug}.md`);
        const existing = raw.ok ? await raw.text() : '';
        file = (existing && applyProposal(existing, fields)) || buildFallbackFile(item, fields);
      } catch {
        file = buildFallbackFile(item, fields);
      }
      await copyText(file);
      downloadMarkdown(`${item.slug}.md`, file);
      if (githubEdit) {
        githubEdit.href = `https://github.com/${config.repo}/edit/main/src/content/chapitres/${item.slug}.md`;
      }
      show(fallbackEl);
      setStatus('Fichier copié et téléchargé. Ouvrez GitHub pour créer la PR.');
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      hide(successEl);
      hide(fallbackEl);
      hide(errorEl);

      const data = new FormData(form);
      if (data.get('website')) return;

      const item = currentChapter();
      const fields = {
        mode: String(data.get('mode') || 'traduire'),
        contributor: String(data.get('contributor') || '').trim(),
        titleFr: String(data.get('titleFr') || '').trim(),
        body: String(data.get('body') || '').trim(),
      };

      if (!item) {
        show(errorEl);
        if (errorDetail) errorDetail.textContent = labels.missingSlug;
        return;
      }
      if (fields.body.length < 200) {
        show(errorEl);
        if (errorDetail) errorDetail.textContent = 'La traduction est trop courte (200 caractères minimum).';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = labels.submitting;

      const proposalId = crypto.randomUUID();
      const headRef = `traduction/${item.slug}-${proposalId.slice(0, 8)}`;

      try {
        if (!config.token) {
          await useFallback(item, fields);
          return;
        }

        const chunks = splitChunks(fields.body);
        for (let i = 0; i < chunks.length; i += 1) {
          setStatus(`Envoi du fragment ${i + 1}/${chunks.length}…`);
          await dispatchChunk({
            slug: item.slug,
            proposalId,
            chunkIndex: i,
            chunkTotal: chunks.length,
            chunk: chunks[i],
            titleFr: fields.titleFr,
            contributor: fields.contributor,
            mode: fields.mode,
          });
        }

        setStatus('Création de la pull request en cours…');
        const pr = await waitForPr(headRef);
        hide(statusEl);
        if (prLink) prLink.href = pr ? pr.html_url : config.pullsUrl;
        if (pr && prLink) prLink.textContent = `${labels.successLink} #${pr.number} →`;
        show(successEl);
      } catch (error) {
        try {
          await useFallback(item, fields);
        } catch {
          show(errorEl);
          if (errorDetail) errorDetail.textContent = error.message || 'Erreur inattendue.';
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = labels.submit;
      }
    });
  </script>
</Layout>
