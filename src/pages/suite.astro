---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const chapitres = await getCollection('chapitres');
const cycles = await getCollection('cycles');
const base = import.meta.env.BASE_URL;
const path = (p) => base.replace(/\/$/, '') + (p.startsWith('/') ? p : '/' + p);
const t = (await getEntry('textes', 'traduction')).data;

const deCycles = cycles
  .filter((c) => c.data.type === 'de')
  .sort((a, b) => a.data.cycleNumber - b.data.cycleNumber);

const progress = deCycles.map((c) => {
  const items = chapitres.filter((ch) => ch.data.cycleNumber === c.data.cycleNumber);
  const total = c.data.bookEnd - c.data.bookStart + 1;
  const done = items.filter((ch) => ch.data.statut === 'traduit').length;
  return {
    cycle: c,
    done,
    total,
    pct: total > 0 ? Math.round((done / total) * 100) : 0,
  };
});

const totalDone = chapitres.filter((ch) => ch.data.statut === 'traduit').length;
const totalAvailable = deCycles.reduce((sum, c) => sum + (c.data.bookEnd - c.data.bookStart + 1), 0);
const overallPct = totalAvailable > 0 ? Math.round((totalDone / totalAvailable) * 100) : 0;
---

<Layout title="La traduction - Perry Rhodan Fan" description="La traduction fan en français des fascicules de Perry Rhodan inédits en France, après l'arrêt de l'édition française au n° 379 (2020).">
  <div class="min-h-screen bg-slate-900">
    <main class="max-w-5xl mx-auto px-4 py-16 pt-24">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-600/20 border border-purple-500/30 text-purple-200 text-sm mb-6">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          {t.badge}
        </div>
        <h1 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-purple-300 via-cyan-200 to-blue-300 bg-clip-text text-transparent mb-6">
          {t.title}
        </h1>
        <p class="text-lg text-blue-200 max-w-3xl mx-auto">
          {t.intro}
        </p>
      </div>

      <div class="mb-12 p-8 bg-gradient-to-br from-slate-800/60 to-slate-900/60 rounded-xl border border-purple-500/20">
        <h2 class="text-2xl font-bold text-purple-300 mb-3">{t.whatTitle}</h2>
        <p class="text-blue-100/90 leading-relaxed">
          {t.whatText}
        </p>
      </div>

      <div class="mb-12">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-2xl font-bold text-cyan-400">{t.progressTitle}</h2>
          <span class="text-blue-200 font-mono">{t.progressCount.replace('{done}', totalDone).replace('{total}', totalAvailable).replace('{pct}', overallPct)}</span>
        </div>
        <div class="h-4 bg-slate-800 rounded-full overflow-hidden border border-blue-500/20">
          <div class="h-full bg-gradient-to-r from-purple-500 to-cyan-400 transition-all" style={`width:${overallPct}%`}></div>
        </div>
        <p class="text-xs text-blue-200/60 mt-2 text-right">{t.progressHint}</p>
      </div>

      <h2 class="text-2xl font-bold text-blue-400 border-l-4 border-blue-400 pl-4 mb-6">
        {t.byCycleTitle}
      </h2>

      <div class="space-y-6">
        {progress.map((p) => (
          <a
            href={path(`cycles/${p.cycle.data.cycleNumber}`)}
            class="block p-6 bg-slate-800/50 rounded-xl border border-blue-500/20 hover:border-purple-400/50 transition-all duration-300"
          >
            <div class="flex items-center justify-between mb-3">
              <div>
                <div class="flex items-center gap-3">
                  <span class="text-2xl font-bold text-purple-400/60">{String(p.cycle.data.cycleNumber).padStart(2, '0')}</span>
                  <span class="text-lg font-bold text-white">{p.cycle.data.title}</span>
                </div>
                <p class="text-xs text-blue-200/70 mt-1">{t.fascLabel.replace('{start}', p.cycle.data.bookStart).replace('{end}', p.cycle.data.bookEnd)}</p>
              </div>
              <span class="text-blue-200 font-mono text-sm shrink-0">{p.done}/{p.total} · {p.pct}%</span>
            </div>
            <div class="h-2.5 bg-slate-800 rounded-full border border-blue-500/20 overflow-hidden">
              <div class="h-full bg-gradient-to-r from-blue-500 to-purple-400 transition-all duration-300" style={`width:${p.pct}%`}></div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-16 p-8 bg-gradient-to-br from-purple-950/40 to-slate-900/60 rounded-xl border border-purple-500/20 text-center">
        <h2 class="text-2xl font-bold text-purple-200 mb-3">{t.contributeTitle}</h2>
        <p class="text-blue-100/90 max-w-2xl mx-auto mb-6">{t.contributeText}</p>
        <a
          href={path('traduire')}
          class="inline-block px-8 py-3 bg-slate-800/80 hover:bg-slate-700 text-blue-100 font-semibold rounded-lg border border-purple-400/40 transition-all"
        >
          {t.contributeCta} →
        </a>
      </div>

      <div class="mt-10 text-center">
        <a
          href={path('cycles')}
          class="inline-block px-10 py-5 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white text-lg font-semibold rounded-lg shadow-xl shadow-purple-500/40 transform hover:scale-105 transition-all duration-300"
        >
          {t.cta} →
        </a>
      </div>
    </main>
  </div>
</Layout>